        <register>
          <name>BGCOLOR</name>
          <description>Specifies the main background color.</description>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>REDCOLOR</name>
              <description>Color red is used as background color</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>

