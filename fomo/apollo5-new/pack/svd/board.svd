        <register>
          <name>TMR6CMP0</name>
          <description>This contains the Compare limits for timer 6. This is the primary comparator that can be used to mark the END of a timer cycle (and thus restart the timer for repeat modes)</description>
          <addressOffset>0x000002C8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>TMR6CMP0</name>
              <description>Counter/Timer 6 End Compare Register. For MEASURE mode indicates the high phase sample count.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>TMR6CMP1</name>
          <description>This comparator is used as a secondary compare count for modes that generate pulses. For MEASURE mode indicates the low phase sample count.</description>
          <addressOffset>0x000002CC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>TMR6CMP1</name>
              <description>Holds the secondary comparator that can be used to generate a PWM or generate secondary pulses. CMP0 should ALWAYS be used first.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
