              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLED</name>
                  <description>Maximum Delta function is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
