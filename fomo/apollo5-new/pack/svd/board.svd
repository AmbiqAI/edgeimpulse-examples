                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TMR11</name>
                  <description>Trigger source is TIMER 1 Output 1</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TMR20</name>
                  <description>Trigger source is TIMER 2 Output 0</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TMR21</name>
                  <description>Trigger source is TIMER 2 Output 1</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TMR30</name>
                  <description>Trigger source is TIMER 3 Output 0</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TMR31</name>
                  <description>Trigger source is TIMER 3 Output 1</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TMR40</name>
                  <description>Trigger source is TIMER 4 Output 0</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TMR41</name>
                  <description>Trigger source is TIMER 4 Output 1</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TMR50</name>
                  <description>Trigger source is TIMER 5 Output 0</description>
                  <value>10</value>
                </enumeratedValue>
