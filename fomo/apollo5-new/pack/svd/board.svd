                </enumeratedValue>
                <enumeratedValue>
                  <name>DM</name>
                  <description>DM lifecycle state</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SE</name>
                  <description>SE lifecycle state</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RMA</name>
                  <description>RMA lifecycle state</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>HOSTSHADOWKDRREG</name>
          <description>This register interface is used to update the RKEK(KDR) registers when the device is in CM or DM mode , it is Write-once (per warm boot) in RMA LCS, The RKEK is updated by shifting .</description>
          <addressOffset>0x00001F18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

