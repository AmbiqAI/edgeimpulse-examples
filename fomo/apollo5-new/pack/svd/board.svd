          <resetMask>0x000001FF</resetMask>

          <fields>
            <field>
              <name>HOSTDFAENABLELOCK</name>
              <description>When this FW control is set, the DFA_ENABLE register cant be written until the next POR. The DFA_ENABLE_LOCK register is set-once (per POR).</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HOSTFORCEDFAENABLE</name>
              <description>When this FW controlled register is set, the AES DFA countermeasures are enabled_disabled (regardless of the AES_DFA_IS_ON register value).</description>
