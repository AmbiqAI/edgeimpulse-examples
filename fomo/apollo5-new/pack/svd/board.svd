                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BOTH</name>
                  <description>Trigger on either edge of TRIGSEL source</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
