              <description>MEM LDO ACTIVE control. Override for PWRCTRL going to analog when MEMLDOOVER = 1</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>MEMLDOACTIVEEARLY</name>
              <description>MEM LDO EARLY ACTIVE control. Override for PWRCTRL going to analog when MEMLDOOVER = 1</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>MEMLDOPDNB</name>
              <description>MEM LDO PDNB control. Override signal for PWRCTRL going to analog when MEMLDOOVER = 1</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>MEMLDOOVER</name>
              <description>Override control for MEM LDO signals</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CORELDOCOLDSTARTEN</name>
              <description>CORE LDO COLDSTART EN control. This is a shadow backed register and no need to set CORELDOOVER.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CORELDOACTIVE</name>
              <description>CORE LDO ACTIVE control. Override for PWRCTRL going to analog when CORELDOOVER = 1</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CORELDOACTIVEEARLY</name>
              <description>CORE LDO EARLY ACTIVE control. Override for PWRCTRL going to analog when CORELDOOVER = 1</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CORELDOPDNB</name>
              <description>CORE LDO PDNB control. Override for PWRCTRL going to analog when CORELDOOVER = 1</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CORELDOOVER</name>
              <description>Override control for CORE LDO signals</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
