        <register>
          <name>CTRL6</name>
          <description>This includes the Control bit fields for timer 6.</description>
          <addressOffset>0x000002C0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFF03FFFF</resetMask>

          <fields>
            <field>
              <name>TMR6LMT</name>
              <description>This field decides the number of iterations of Counter/Timer 6. For Single/Repeat Patterns, it indicates number of bits to be shifted out and so, max value is 63.</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TMR6TMODE</name>
              <description>Counter/Timer 6 Trigger Mode</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Trigger not enabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RISE</name>
                  <description>Trigger on rising edge of TRIGSEL source</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FALL</name>
                  <description>Trigger on falling edge of TRIGSEL source</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
