          <resetValue>0x00000000</resetValue>
          <resetMask>0xFF03FFFF</resetMask>

          <fields>
            <field>
              <name>TMR3LMT</name>
              <description>This field decides the number of iterations of Counter/Timer 3. For Single/Repeat Patterns, it indicates number of bits to be shifted out and so, max value is 63.</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TMR3TMODE</name>
              <description>Counter/Timer 3 Trigger Mode</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Trigger not enabled</description>
                  <value>0</value>
