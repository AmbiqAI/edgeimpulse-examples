              <enumeratedValues>
                <enumeratedValue>
                  <name>SATCBINT</name>
                  <description>Saturation, as specified by SAT configuration registers, occurred on either slot 2 or 3 (channel B)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NONSATCBINT</name>
                  <description>No-Saturation</description>
