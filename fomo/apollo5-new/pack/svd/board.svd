              <bitRange>[17:12]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>REGR</name>
              <description>Result register virtual address 0-15.</description>
              <bitRange>[11:6]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TAG</name>
              <description>Holds the operations tag or the operand C virtual address.</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
