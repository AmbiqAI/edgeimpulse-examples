              <bitRange>[14:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>SRAMDATAREADY</name>
          <description>The SRAM content is ready for read in SRAM_DATA.</description>
          <addressOffset>0x00000F08</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>SRAMREADY</name>
