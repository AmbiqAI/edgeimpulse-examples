        <register>
          <name>HFADJ</name>
          <description>This register controls the HFRC adjustment. The HFRC clock can change with temperature and process corners, and this register controls the HFRC adjustment logic which reduces the fluctuations to the clock.</description>
          <addressOffset>0x00000020</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0025B800</resetValue>
          <resetMask>0x1FFFFF0F</resetMask>

          <fields>
            <field>
              <name>HFADJMAXDELTA</name>
