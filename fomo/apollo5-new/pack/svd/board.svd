              <bitRange>[10:10]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ERRORPROVZEROCNT</name>
              <description>Indication that the number of zeroes in the loaded KCP is not equal to the value set in the OEM flag.</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ERRORKDRZEROCNT</name>
              <description>Indication that the number of zeroes in the loaded KDR is not equal to the value set in the manufacture flag.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>

