        <register>
          <name>VRSTATUS</name>
          <description>Provides BUCK and LDOs status.</description>
          <addressOffset>0x00000108</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000003F</resetMask>

          <fields>
            <field>
              <name>SIMOBUCKST</name>
              <description>Indicates SIMO BUCK status. bit[1] indicates ON/OFF and bit[0] indicates ACT/LP</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Indicates the the SIMO BUCK is OFF.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LP</name>
                  <description>Indicates the the SIMO BUCK is ON and in LP mode.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACT</name>
                  <description>Indicates the the SIMO BUCK is ON and in ACT mode.</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MEMLDOST</name>
              <description>Indicates MEMLDO status. bit[1] indicates ON/OFF and bit[0] indicates ACT/LP.</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Indicates the the MEMLDO is OFF.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LP</name>
                  <description>Indicates the the MEMLDO is ON and in LP mode.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACT</name>
                  <description>Indicates the the MEMLDO is ON and in ACT mode.</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CORELDOST</name>
              <description>Indicates CORELDO status. bit[1] indicates ON/OFF and bit[0] indicates ACT/LP.</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Indicates the the CORELDO is OFF.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LP</name>
                  <description>Indicates the the CORELDO is ON and in LP mode.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACT</name>
                  <description>Indicates the the CORELDO is ON and in ACT mode.</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
