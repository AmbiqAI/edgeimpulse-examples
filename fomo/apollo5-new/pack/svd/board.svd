          <fields>
            <field>
              <name>TMR1LMT</name>
              <description>This field decides the number of iterations of Counter/Timer 1. For Single/Repeat Patterns, it indicates number of bits to be shifted out and so, max value is 63.</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TMR1TMODE</name>
              <description>Counter/Timer 1 Trigger Mode</description>
              <bitRange>[17:16]</bitRange>
