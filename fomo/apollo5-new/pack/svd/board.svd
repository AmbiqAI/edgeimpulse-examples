                  <name>SDIV_15</name>
                  <description>Divided by 15</description>
                  <value>15</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LVDS</name>
              <description>Clock phase shift value for LVDS operation</description>
              <bitRange>[26:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>PLL</name>
