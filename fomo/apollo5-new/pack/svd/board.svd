            <field>
              <name>CLMDLUT8</name>
              <description>Indicates that the LUT8 color format is enabled</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CLMDRGBA5551</name>
              <description>Indicates that the RGBA5551 16-bit color format is enabled</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CLMDRGBA8888</name>
              <description>Indicates that the RGBA8888 32-bit color format is enabled</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CLMDRGB332</name>
              <description>Indicates that the RGB332 8-bit color format is enabled</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CLMDRGB565</name>
              <description>Indicates that the RGB565 16-bit color format is enabled</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CLMDARGB8888</name>
              <description>Indicates that the ARGB8888 32-bit color format is enabled</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CLMDL8</name>
              <description>Indicates that the L8 color format is enabled</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CLMDL1</name>
              <description>Indicates that the L1 color format is enabled</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CLMDL4</name>
              <description>Indicates that the L4 color format is enabled</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CLMDYUYV</name>
              <description>Indicates that the YUYV color format is enabled</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CLMDRGB888</name>
              <description>Indicates that the RGB888 24-bit color format is enabled</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CLMDYUY2</name>
              <description>Indicates that the YUY2 color format is enabled</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CLMDABGR8888</name>
              <description>Indicates that the ABGR8888 32-bit color format is enabled</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CLMDBGRA8888</name>
              <description>Indicates that the BGRA8888 32-bit color format is enabled</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CLMDVYUV420</name>
              <description>Indicates that the V_YUV420 color format is enabled</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CLMDTLYUV420</name>
              <description>Indicates that the TLYUV420 color format is enabled</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CLMDTSC4TSC6</name>
              <description>Indicates that the TSc4/TSc6 propietary color format is enabled</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>CRC</name>
          <description>if cyclic redundancy errors occur, they are written in the CRC register.</description>
          <addressOffset>0x00000184</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>CRCREG</name>
              <description>CRC value if CRC error exists</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>GLLUT</name>
          <description>R[0]G[0]B[0] thru R[255]G[255]B[255] Global palette, gamma correction memory region where x starts at 0 thru 255.Access to all 256 registers is best accomplished by passing an index via a macro. e.g. pseudocode  #define DC_L0LUT(n) (*((volatile uint32_t*)(&amp;L0LUT + (4*n))))</description>
          <addressOffset>0x00000400</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00FFFFFF</resetMask>

          <fields>
            <field>
              <name>GLLUT0GAMRAMPR</name>
              <description>Gamma ramp red bits</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>GLLUT0GAMRAMPG</name>
              <description>Gamma ramp green bits</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>GLLUT0GAMRAMPB</name>
              <description>Gamma ramp blue bits</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>CURSORDATA</name>
          <description>Color values for the pixel cursor that are used with the Cursor LUT where x starts at 0 thru 127.Access to all 16 registers is best accomplished by passing an index via a macro. e.g. pseudocode  #define DC_CURSORDATA(n) (*((volatile uint32_t*)(&amp;CURSORDATA + (4*n))))</description>
          <addressOffset>0x00000800</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFF0FF</resetMask>

          <fields>
            <field>
              <name>CURDATA3112</name>
              <description>Pixel 'xy' color look up bits</description>
              <bitRange>[31:12]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CURDATA70</name>
              <description>Pixel 'xy' color look up bits</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>CURSORLUT</name>
          <description>R[0]G[0]B[0] thru R[15]G[15]B[15] Cursor Look-up Table where x starts at 0 thru 15.Access to all 16 registers is best accomplished by passing an index via a macro. e.g. pseudocode  #define DC_CURSORLUT(n) (*((volatile uint32_t*)(&amp;CURSORLUT + (4*n))))</description>
          <addressOffset>0x00000A00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00FFFFFF</resetMask>

          <fields>
            <field>
              <name>CURLUT0R</name>
              <description>Cursor LUT red bits</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CURLUT0G</name>
              <description>Cursor LUT green bits</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CURLUT0B</name>
              <description>Cursor LUT blue bits</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>L0LUT</name>
          <description>A[0]R[0]G[0]B[0] thru A[255]R[255]G[255]B[255]. Layer 0 palette,gamma correction memory region where x starts at 0 thru 255.</description>
          <addressOffset>0x00001000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>L0LUT0GAMRAMPA</name>
              <description>Gamma ramp alpha bits</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>L0LUT0GAMRAMPR</name>
              <description>Gamma ramp red bits</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>L0LUT0GAMRAMPG</name>
              <description>Gamma ramp green bits</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>L0LUT0GAMRAMPB</name>
              <description>Gamma ramp blue bits</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>L1LUT</name>
          <description>A[0]R[0]G[0]B[0] thru A[255]R[255]G[255]B[255] Layer 1 palette,gamma correction memory region where x starts at 0 thru 255.Access to all 256 registers is best accomplished by passing an index via a macro. e.g. pseudocode  #define DC_L1LUT(n) (*((volatile uint32_t*)(&amp;L1LUT + (4*n))))</description>
          <addressOffset>0x00001400</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>L1LUT0GAMRAMPA</name>
              <description>Gamma ramp alpha bits</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>L1LUT0GAMRAMPR</name>
              <description>Gamma ramp red bits</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>L1LUT0GAMRAMPG</name>
              <description>Gamma ramp green bits</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>L1LUT0GAMRAMPB</name>
              <description>Gamma ramp blue bits</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>L2LUT0</name>
          <description>A[0]R[0]G[0]B[0] thru A[255]R[255]G[255]B[255] Layer 2 palette,gamma correction memory region where x starts at 0 thru 255.Access to all 256 registers is best accomplished by passing an index via a macro. e.g. pseudocode  #define DC_L2LUT(n) (*((volatile uint32_t*)(&amp;L2LUT + (4*n))))</description>
          <addressOffset>0x00001800</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>L2LUT0GAMRAMPA</name>
              <description>Gamma ramp alpha bits</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>L2LUT0GAMRAMPR</name>
              <description>Gamma ramp red bits</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>L2LUT0GAMRAMPG</name>
              <description>Gamma ramp green bits</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>L2LUT0GAMRAMPB</name>
              <description>Gamma ramp blue bits</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>L3LUT</name>
          <description>A[0]R[0]G[0]B[0] thru A[255]R[255]G[255]B[255] Layer 3 palette,gamma correction memory region where x starts at 0 thru 255.Access to all 256 registers is best accomplished by passing an index via a macro. e.g. pseudocode  #define DC_L3LUT(n) (*((volatile uint32_t*)(&amp;L3LUT + (4*n))))</description>
          <addressOffset>0x00001C00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>L3LUT0GAMRAMPA</name>
              <description>Gamma ramp alpha bits</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>L3LUT0GAMRAMPR</name>
              <description>Gamma ramp red bits</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>L3LUT0GAMRAMPG</name>
              <description>Gamma ramp green bits</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>L3LUT0GAMRAMPB</name>
              <description>Gamma ramp blue bits</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>DSI</name>
      <version>1.0</version>
      <description>Digital Serial Interface Unit</description>
      <!-- <groupName>GROUP_DSI</groupName> -->
      <baseAddress>0x400A8000</baseAddress>
      <size>32</size>
      <access>read-write</access>

      <addressBlock>
        <offset>0</offset>
        <size>0x000000A4</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>DSI</name>
        <description>DSI_IRQ</description>
        <value>30</value>
      </interrupt>
      <registers>
        <register>
          <name>DEVICEREADY</name>
          <description>Devide Ready register</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000000F</resetMask>

          <fields>
            <field>
              <name>DISPLAYBUSPOSSESSEN</name>
              <description>Inform DSI receiver has to be given the bus possession for receiving the tearing effect trigger message; Reset by the processor to stop the bus possession of the DSI receiver; Note: Tearing effect is supported only in Type1; Display Architecture (command mode only) as suggested by Display Command Set Specification; Note1: Even if the processor does not clear the display_bus_possession bit after receiving the interrupt for tearing effect, DSI-tx controller starts the activities on the DSI link once the TE trigger message is received</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ULPS</name>
              <description>ULPS field of the DEVICEREADY register.</description>
              <bitRange>[2:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOW_POWER</name>
                  <description>This pattern is set by the processor to inform that entire DSI host is to be put on ultra low power [POWER SAVING] mode 01 - This pattern is set by the processor to inform</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EXIT</name>
                  <description>This pattern is set by the processor to inform that entire DSI host is to be pu on ultr low power EXIT mode</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>This</name>
                  <description>pattern is set by the processor to make the DSI host come out of the wakeup time and resume the normal operation if the DSI Host already remains in the ULPS exit state. S/W needs to ensure that there is a minimum of 1ms time available before clearing the UPLS exit State. 1(a). In DPI Only Mode: No DPI traffic should be sent after the above patterns like 10 or 01 is set in this register. Device_ready bit in Device Ready register should not be disturbed or should remain set while the device is subjected to ULPS states. 1(b). In Dual Display Mode: DPI Interface has to be disabled and also no DBI traffic should be sent after the above patterns like 10 or 01 is set in this register. Device_ready bit in Device Ready register should not be disturbed or should remain set while the device is subjected to ULPS states.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>READY</name>
              <description>Ready for programming after all count registers and timeout.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PROGRAMMED</name>
                  <description>Set to 1 after dphy_parameter register, all the count registers, and timeout and interrupt enable registers are being programmed.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READY</name>
                  <description>Set by the processor to inform that device is ready for transmission. This register should be set to 1 after dphy_parameter register, all the count registers, and timeout and interrupt enable registers are being programmed. Note: Reprogramming the registers by resetting the device_ready bit results in re-enumeration of the DSI controller from the power up sequence.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>INTRSTAT</name>
          <description>The interrupt status register.</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>DPIPRGERR</name>
              <description>(RW1C) Set to 1 indicates that the error in DPI parameters programming</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DPILINETO</name>
              <description>(RW1C) DPI line time out. Set to 1 indicates that the line time out during the DPI transfer</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXCNT</name>
              <description>(RW1C) Rx Contention; Set to 1 if contention detected in the display</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>INITDONE</name>
              <description>(RW1C) Set 1 indicates that the DSI initialization is done. DSI        Tx is ready to accept the DPI or DBI or Generic transfer</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>SPECIALPACK</name>
              <description>(RW1C) Special packet command sent; Set to confirm the transmission of the DPI event specific commands set in the dpi control and dpi data</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXDSIPROT</name>
              <description>(RW1C) Rx DSI protocol violation; Set if acknowledge short packet shows DSI protocol violation error</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXINVALID</name>
              <description>(RW1C) Rx Invalid; Set if acknowledge short packet shows an invalid transmission count</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ACKWNOERR</name>
              <description>(RW1C) T  ACK_with No_error; Set if acknowledge trigger message is received with out any error.</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TURNARNDACK</name>
              <description>(RW1C) Turn around acknowledge. Set if a turn around acknowledgement sequence is timeout not received from the display device</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LPRXTIMEOUT</name>
              <description>(RW1C) Set if a low power reception count expires this interrupt is generated</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HSTXTIMEOUT</name>
              <description>(RW1C) Set if a high speed transmission prevails for more than the expected count value this interrupt is raised</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>FIFOEMPTY</name>
              <description>(RW1C) Set to 1 if all FIFOs are empty</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LOWC</name>
              <description>(RW1C) Low contention; Set to 1 if a LP low fault is registered by at the D-PHY contention detector. If this interrupt is set device should be re-enumerated</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HIGHC</name>
              <description>(RW1C) High contention;Set to 1 if a LP high fault is registered by at the D-PHY contention detector. If this interrupt is set device should be re-enumerated</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TxDSII</name>
              <description>(RW1C) TxDSI VC ID invalid; Set to 1 if the received virtual channel ID is invalid</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TxDSIN</name>
              <description>(RW1C) TxDSI data type not recognised; Set to 1 if the received data type is not recognised</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TXCHECKSUM</name>
              <description>(RW1C) Txchecksum error; Set to 1 if the computed CRC differs from the received CRC value during the reception of packets by Arasan_DSI host</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TXECCM</name>
              <description>(RW1C) Set to 1 if there is no ECC correction for the packet or there are more than 2 bit errors in the packet received by Arasan_DSI_host.</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TXECCS</name>
              <description>(RW1C) Set to 1 if ECC syndrome was computed and is corrected for one bit error during the reception of packets by the Arasan_DSI_host.</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TXFALSECNTRL</name>
              <description>(RW1C) TxFalse Control Error; Set to 1 if a control error is observed on the lanes by the Arasan_DSI_host</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RxDSIDI</name>
              <description>(RW1C) RxDSI VC ID invalid; Set to 1 if the virtual channel ID is invalid by the display device is reported in the Acknowledge packet by the display device</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RxDSINR</name>
              <description>(RW1C) RxDSI data type not recognised; Set to 1 if the data type is not recognised by the display device is reported in the Acknowledge packet by the display device</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXCHECKSUM</name>
              <description>(RW1C) Set to 1 if the computed CRC differs from the received CRC value and is reported in the acknowledge packet by the display device</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RxECCM</name>
              <description>(RW1C) RxECC multibit error; Set to 1 if there is no ECC correction for the packet or there are more than 2 bit errors in the packet isreported in the Acknowledge packet by the display device</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RxECCS</name>
              <description>(RW1C) RRxECC single bit error; Set to 1 if ECC syndrome was computed and corrected for one bit error is reported in the Acknowledge packet by the display device</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXFALSECNTRL</name>
              <description>(RW1C) RxFalse Control Error; Set to 1 if a control error is reported in the acknowledge packet by the display device</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXPERIPHERAL</name>
              <description>(RW1C) Rx Peripheral timeout Error; Set to 1 if the high speed receive timer value or LP Tx timer value are expired, display device is reported in the Acknowledge packet</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXLPTXSYNCERR</name>
              <description>(RW1C) Rx LP tx sync error; Set to 1 if Low power transmission sync error occurs in the display device and is reported in the Acknowledge packet by the display device</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXESCAPEMODE</name>
              <description>(RW1C) Entry Error;  Set to 1 if Escape Mode Entry command is not understandable by the display device and is reported in the Acknowledge packet by the display device.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXEOTSYNCERROR</name>
              <description>(RW1C) Set to 1 if End of transmission synchronisation Error is reported in the acknowledgment packet by the display device</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXSOTSYNCERROR</name>
              <description>(RW1C) Set to 1 if synchronisation error occurrence in the   start of transmission sequence is reported in the acknowledge packet by the display device</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXSOTERROR</name>
              <description>(RW1C) Set to 1 if a start of transmission sequence error is reported in the Acknowledge packet by the display device</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>INTREN</name>
          <description>Interrupt enable register.</description>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>DPI</name>
              <description>PGRMERR     DPI program error; Set to 1 indicates that the error in DPI parameters programming</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DPILINETO</name>
              <description>Dpi line timeout; Set to 1 indicates that the line time out during the DPI transfer</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXCONTENT</name>
              <description>Detected  Rx Contention Detected; Set to enable the interrupt for contention detected error in the acknowledgment packet reports</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>INITDONE</name>
              <description>Set 1 indicates that the DSI initialisation is done DSI Tx is ready to accept the DPI or DBI or Generic transfer</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>SPECIALPACK</name>
              <description>Special packet command sent; Set to enable the confirmation interrupt for transmitting DPI events set in the dpi data and dpi control registers</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXDSI</name>
              <description>Rx DSI protocol violation; Set to enable DSI protocol violation error</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXINV</name>
              <description>Rx Invalid transmission count error; Set to enable acknowledge invalid transmission counterror</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ACKWITHNOERR</name>
              <description>ACK with No_error; Set to enable acknowledge trigger message reception with out any error</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TURNARNDACK</name>
              <description>Set to enable turn around acknowledgement sequence timeout</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LPRXTIMEOUT</name>
              <description>Set to enable low power reception count timeouts</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HSTXTIMEOUT</name>
              <description>Set to enable a high speed transmission timeout</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>FIFOEMPTY</name>
              <description>Set to enable a FIFO empty interrupt</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LOWC</name>
              <description>Low contention; Set to enable a LP low fault interrupt</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HIGHC</name>
              <description>High contention; Set to enable a LP high fault interrupt</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TxDSIV</name>
              <description>TxDSI VC ID invalid; Set to enable the interrupt if the received packets virtual channel ID is invalid</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TxDSID</name>
              <description>TxDSI data type not recognised; Set to enable the interrupt if the received packets data type is not recognised</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TXCHCKSUM</name>
              <description>Txchecksum error; Set to enable the interrupt if the computed CRC differs from the received CRC value for the received packets</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TxECCM</name>
              <description>TxECC multibit; Set to enable the interrupt if there is no ECC correction for the packet or there are more than 2 bit errors in the packet received by Arasan DSI host</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TxECCS</name>
              <description>TxECC single bit; Set to enable the interrupt if ECC syndrome was computed and is corrected for one bit error during the reception of packets by the Arasan DSI Host</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TxFalseCntrl</name>
              <description>TxFalse Control; Set to enable the interrupt for the control error observed on the lanes by the Arasan_DSI_host</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RxDSIV</name>
              <description>RxDSI VC ID invalid virtual channel; Set to enable the interrupt for invalid ID in the acknowledgment packet reports</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RxDSIData</name>
              <description>RxDSI data type not recognised; Set to enable the interrupt for the un recognised data type in the acknowledgment packet reports</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXCHECKSUM</name>
              <description>Rxchecksum error; Set to enable the interrupt for the computed CRC differs from the received CRC value in the acknowledgment packet reports</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXECCM</name>
              <description>RxECC multibit error; Set to enable the interrupt for no ECC correction for the packet or there are more than 2 bit errors reported in the acknowledgment packet</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXECCS</name>
              <description>RxECC single bit error; Set to enable the interrupt for ECC syndrome computation and one bit error correction for the acknowledgment packet</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXFALSE</name>
              <description>RxFalse Control error; set to enable the interrupt for control error in the acknowledgment packet reports.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXPERIPHRCVTOE</name>
              <description>Peripheral receive timeout Error; Set to enable the interrupt for the high speed timeout Error or Lp tx timeout error in the acknowledgment packet reports</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXLPTXSYNCERR</name>
              <description>Rx LP tx sync error; Set to enable the interrupt for Low power transmission sync error in the acknowledgment packet reports</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXESCPMDETRYERR</name>
              <description>RxEscape Mode Entry Error; Set to enable the interrupt for Escape Mode Entry command error in the acknowledgment packet reports</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXEOTSYNCRR</name>
              <description>RxEot Sync Error l set to enable the interrupt for the end of transmission synchronisation Error in the acknowledgment packet reports</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXSOTSYNCERROR</name>
              <description>RX start of transmission; Set to enable the interrupt for start of transmission synchronization error in the acknowledgement packet reports</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXSOTERROR</name>
              <description>RX start of transmission; set to enable the interrupt for start of transmission</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>DSIFUNCPRG</name>
          <description>DSI function programming register</description>
          <addressOffset>0x0000000C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0x0000E3FF</resetMask>

          <fields>
            <field>
              <name>REGNAME</name>
              <description>Field description needed here.</description>
              <bitRange>[15:13]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>command</name>
                  <description>mode is not supported]</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>16BIT</name>
                  <description>16 bit data</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>9BIT</name>
                  <description>9 bit data</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8BIT</name>
                  <description>8 bit data</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SUPCOLVIDMODE</name>
              <description>Supported colour format for video mode.</description>
              <bitRange>[9:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FMTVMODE0</name>
                  <description>Video mode is not supported</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FMTVMODE1</name>
                  <description>RGB565 or 16-bit format</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FMTVMODE2</name>
                  <description>RGB666 or 18-bit format</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FMTVMODE3</name>
                  <description>RGB 666 loosely packed format</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FMTVMODE4</name>
                  <description>RGB888 or 24-bit format</description>
                  <value>4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CHNUMCMODE</name>
              <description>Channel Number for command mode is programmed by the processor</description>
              <bitRange>[6:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>VCCH0</name>
                  <description>Virtual command mode channel 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VCCH1</name>
                  <description>Virtual command mode channel 1</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VCCH2</name>
                  <description>Virtual command mode channel 2</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VCCH3</name>
                  <description>Virtual command mode channel 3</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CHNUMVM</name>
              <description>Channel number for video mode</description>
              <bitRange>[4:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>VVCH0</name>
                  <description>Virtual  video mode  channel 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VVCH1</name>
                  <description>Virtual  video mode  channel 1</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VVCH2</name>
                  <description>Virtual  video mode  channel 2</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VVCH3</name>
                  <description>Virtual  video mode  channel 3</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DATALANES</name>
              <description>The number  Data lanes to be supported is programmed by the processor</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DATAL0</name>
                  <description>Zero data lane</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DATAL1</name>
                  <description>One data lane</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DATAL2</name>
                  <description>Two data lane</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DATAL3</name>
                  <description>Three data lane</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DATAL4</name>
                  <description>Four data lane</description>
                  <value>4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>HSTXTIMEOUT</name>
          <description>Maximum duration allow for the DSi host to remain in High speed mode for transmission.</description>
          <addressOffset>0x00000010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000FFFF</resetValue>
          <resetMask>0x00FFFFFF</resetMask>

          <fields>
            <field>
              <name>MAXDURTOCNT</name>
              <description>The maximum duration allowed for the DSI host to remain in high speed mode for a transmission. If the counter expires, processor is interrupted with HS_Tx_timeout interrupt</description>
              <bitRange>[23:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>LPRXTO</name>
          <description>Timeout value to be checked for reverse communicationl</description>
          <addressOffset>0x00000014</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000FFFF</resetValue>
          <resetMask>0x00FFFFFF</resetMask>

          <fields>
            <field>
              <name>TOCHKRVS</name>
              <description>Timeout value to be checked for reverse communication. If the counter expires, processor is interrupted with LP_Rx_timeout interrupt.The timeout value is protocol specific. Time out value is calculated from txclkesc(50ns).</description>
              <bitRange>[23:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>TURNARNDTO</name>
          <description>Timeout value to be checked after the DSI host makes a trun around in the direction of transfers.</description>
          <addressOffset>0x00000018</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000017</resetValue>
          <resetMask>0x0000003F</resetMask>

          <fields>
            <field>
              <name>TIMOUT</name>
              <description>If the counter expires, processor is interrupted with Turn_around_ack timeout interrupt; this specified period shall be longer then the maximum possible turnaround delay for the unit to which the turnaround request was sent, which is 23 clock cycles of txclkesc; any number greater than or equal to 23 is an acceptable number.</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>DEVICERESETTIMER</name>
          <description>Timeout value to be checked for device to be reset after issuing reset entry command</description>
          <addressOffset>0x0000001C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x000000FF</resetValue>
          <resetMask>0x0000FFFF</resetMask>

          <fields>
            <field>
              <name>TIMOUT</name>
              <description>If the timer expires the DSI Host enters normal operation; This time out value is used while contention recovery procedure; the time out value is equal to a value longer than the specified time required to complete the reset sequence</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>DPIRESOLUTION</name>
          <description>Shows the horizontal address count in pixels</description>
          <addressOffset>0x00000020</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>DPIRESOLUTION</name>
              <description>DPIRESOLUTION register description needed here.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HSYNCCNT</name>
          <description>Shows the horizontal sync value in terms of byte clock.</description>
          <addressOffset>0x00000028</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>

          <fields>
            <field>
              <name>HORZCNT</name>
              <description>Shows the horizontal sync value in terms of byte clock (txbyteclkhs); Minimum HSA period should be sufficient to transmit a Hsync start short packet(4 bytes) i) For Non-burst Mode with sync pulse, Min value - 4 in decimal (plus an optional 6 bytes for a zero payload blanking packet); But if the value is less than 10 but more than 4, then this count will be added to the HBP's count for one lane; ii) For Non-Burst Sync Event and Burst Mode, there is no HSA, so you can program this to zero. If you program this register, these byte values will be added to HBP Max value - any 12 bit value greater than 4 based on DPI resolution</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HORIZBKPORCHCNT</name>
          <description>Shows the horizontal back porch value in terms of txbyteclkhs.</description>
          <addressOffset>0x0000002C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>

          <fields>
            <field>
              <name>HORZBKPCNT</name>
              <description>For Non Burst Sync pulse mode, for one lane. Minimum HBP count = Hsync End short packet + HBP Blanking packet overhead (header(4) + crc (2)) + RGB packet header For other lane counts minimum value = Minimum HBPcount / lane_count. For Non Burst Sync event / Burst Mode there is no HSA. Minimum HBP count = (Hsync Start short packet + HBP Blanking packet overhead + RGB packet header) / lane_count Min value - 14 in decimal (accounted with zero payloads for blanking packet] for one lane. Max value - any 12 bit value greater than 14 based on DPI resolution</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HORIZFPORCHCNT</name>
          <description>Shows the horizontal front porch value in terms of txbyteclkhs.</description>
          <addressOffset>0x00000030</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>

          <fields>
            <field>
              <name>HORZFTPCNT</name>
              <description>Minimum HFP period should be sufficient to transmit RGB Data packet footer (2 bytes) + Blanking packet overhead (6 bytes) +adjustable count (16 bytes) for non burst mode; For other lane counts Minimum value = (RGB Data packet footer(2 bytes) + Blanking packet overhead(6 bytes)) / (lane_count) + adjustable count(16 bytes) For burst mode, Minimum HFP period should be sufficient to transmit Blanking packet overhead(6 bytes) +adjustable count (16 bytes) for one lane for other lane counts Minimum value = ( Blanking packet overhead(6 bytes)) / (lane_count) + adjustable count(16 bytes) Min value - 8 in decimal for non-burst mode (accounted with zero payload for blanking packet) for one lane Min value - 6 in decimal for burst mode for one lane Max value - any 12 bit value greater than the minimum value based on DPI resolution; Minimum HFP period should be sufficient to transmit</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HORZACTIVEAREACNT</name>
          <description>Horizontal active area count / time for active image data / Horizontal Address</description>
          <addressOffset>0x00000034</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>

          <fields>
            <field>
              <name>HORACTCNT</name>
              <description>Shows the horizontal active area value in terms of  txbyteclkhs. In Non Burst Mode, Count equal to RGB word count value In Burst Mode, RGB pixel packets are time compressed, leaving more time during a scan line for LP mode (saving power) or for multiplexing other transmissions onto the DSI link. Hence, the count equals the time in txbyteclkhs for sending time compressed RGB pixels plus the time needed for moving to power save mode or the time needed for secondary channel to use the DSI link. But if the left out time for moving to low power mode is less than 8 txbyteclkhs (2txbyteclkhs for RGB data packet footer and 6txbyteclkhs for a blanking packet with zero payload), then this count will be added to the HFPs count for one lane.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>VSYNCCNT</name>
          <description>Shows the vertical sync value</description>
          <addressOffset>0x00000038</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>

          <fields>
            <field>
              <name>VSC</name>
              <description>Shows the vertical sync value in terms of lines. Min value - 2 Max value - any 12 bit value greater than 2 based on DPI resolution</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>VERTBKPORCHCNT</name>
          <description>Shows the vertical back porch value</description>
          <addressOffset>0x0000003C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>

          <fields>
            <field>
              <name>VBPSC</name>
              <description>Shows the vertical back porch value in terms of lines. Min value - 1; Max value - any 12 bit value greater than 1 based on DPI resolution</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>VERTFPORCHCNT</name>
          <description>Shows the vertical front porch value</description>
          <addressOffset>0x00000040</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>

          <fields>
            <field>
              <name>VFPSC</name>
              <description>Shows the vertical front porch value in terms of lines. Min value - 1; Max value - any 12 bit value greater than 1 based on DPI resolution</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>DATALANEHILOSWCNT</name>
          <description>High speed to low power or Low power to high speed switching time</description>
          <addressOffset>0x00000044</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>

          <fields>
            <field>
              <name>DATALHLSWCNT</name>
              <description>High speed to low power or Low power to high speed power or Low switching time in terms byte clock (txbyteclkhs). This power to high speed switch count value is based on the byte clock (txbyteclkhs) and low power clock frequency (txclkesc); Data lane Switch count = 4 * Tlpx + programmed THS_prep + programmed THS_zero + 4 byteclk Tlpx = Low power clock equivalence in of terms byte clock programmed in AHB reg 68h; THS_prep = programmed value of dln_cnt_hs_prep in AHB Reg 6ch bit (7:0) THS_zero = programmed value of dln_cnt_hs_zero in AHB Reg 6ch bit (15:8) Programmable count  should be equal or greater than this value. Typical value x96 Number of byte clocks required to switch from low power mode to high speed mode after txrequesths is asserted.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>DPI</name>
          <description>DPI control register.</description>
          <addressOffset>0x00000048</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000000F</resetMask>

          <fields>
            <field>
              <name>COLORMODEOFF</name>
              <description>Set to 1 to indicate a Color Mode OFF short packet has to be packetised for the DPIs virtual channel</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>COLOR</name>
              <description>MODEON    Set to 1 to indicate a color Mode ON short packet has to be packetised for the DPIs virtual channel.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TURNON1</name>
              <description>Set to 1 to indicate a Turn ON short packet has to be packetised for the DPIs virtual channel</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>SHUTDOWN</name>
              <description>Set to 1 to indicate a shut down short packet has to be packetised for the DPIs virtual channel</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>PLLLOCKCNT</name>
          <description>The PLL counter value</description>
          <addressOffset>0x0000004C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x000007D0</resetValue>
          <resetMask>0x0000FFFF</resetMask>

          <fields>
            <field>
              <name>PLLCNTVAL</name>
              <description>Pll counter value in terms of low power clock.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>INITCNT</name>
          <description>Count register to initialize the DSI HOST IP</description>
          <addressOffset>0x00000050</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x000007D0</resetValue>
          <resetMask>0x0000FFFF</resetMask>

          <fields>
            <field>
              <name>MSTR</name>
              <description>Counter value in terms of low power clock to initialise the DSI Host IP (TINIT) that drives a stop state on the mipis D-PHY bus; DPHY Initialization period min 100 x B5s; Time out value is calculated by txclkesc and the count value is 7d0h(2000 in decimal)</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>MAXRETPACSZE</name>
          <description>MAXRETPACSZE register description needed here.</description>
          <addressOffset>0x00000054</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000087FF</resetMask>

          <fields>
            <field>
              <name>HSLP</name>
              <description>Indicates the data transfer type</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>COUNTVAL</name>
              <description>Set the count value in bytes to collect the return data packet for reverse direction data flow in data lane0 in response to a DBI read operation; Count value equals the maximum size of the payload in a Long packet transmitted from peripheral back to; for DBI and DPI interleaving Min value - 1; Max value - Maximum payload for a long packet size is 1K bytes Note: DCS short Read Response or Long read response with 1 or 2 parameters is applicable in this mode; For DBI only, Min value - 1 Max value - Maximum payload for a long packet size is 1K bytes</description>
              <bitRange>[10:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>VIDEOMODEFMT</name>
          <description>Sets the Video mode format (packet sequence) to be supported in DSI.</description>
          <addressOffset>0x00000058</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000003</resetMask>

          <fields>
            <field>
              <name>VIDEMDFMT</name>
              <description>Sets the Video mode format (packet sequence) to be supported in DSI; in Non Burst Mode, in addition to programming this register the horizontal active area count register value should also be programmed equal to RGB word count value; in Burst Mode, in addition to programming this register the horizontal active area count register value should also be programmed greater than the RGB word count value, leaving more time during a scan line for LP mode (saving power) or for multiplexing other transmissions onto the DSI link;</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>VIDEMDFMT_0</name>
                  <description>VIDEMDFMT enum description needed here.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NONBURSTPULSE</name>
                  <description>Non Burst Mode with Sync Pulse</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NONBURSTEVENTS</name>
                  <description>Non Burst Mode with Sync events</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BURST</name>
                  <description>MODE   Burst Mode</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>CLKEOT</name>
          <description>The EOT clock register disables the video.</description>
          <addressOffset>0x0000005C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000007</resetMask>

          <fields>
            <field>
              <name>BTA</name>
              <description>Disable video; Set by the processor to inform the DSI controller to disable the BTA sent at the last blanking line of VFP. By default, this bit is set to 0; 0    BTA sending at the last blanking line of VFP is enabled; 1 BTA sending at the last blanking line of VFP is disabled</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CLOCK</name>
              <description>Set by the processor to enable or disable clock; Stopping feature during BLLP timing in a DPI transfer in dual channel mode or during DPI only mode and also when there is no traffic in the DBI interface in DBI only enabled mode. By default this register value is 0.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>EOT</name>
              <description>Set by the processor to enable or disable EOT short disable_register packet transmission; vy default this register value is 0; for backward compatibility of earlier DSI systems, EOT short packet transmission can be disabled; 0 EOT short packet transmission enabled, 1  EOT short packet transmission disabled</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>POLARITY</name>
          <description>Polarity Register</description>
          <addressOffset>0x00000060</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000000F</resetMask>

          <fields>
            <field>
              <name>PBITS</name>
              <description>Polarity bits</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>POLV</name>
                  <description>polarity for Vsync</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>POLH</name>
                  <description>Polarity for Hsync</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>POLSD</name>
                  <description>Polarity for shut down</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>POLCM</name>
                  <description>Polarity for Color mode</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>CLKLANESWT</name>
          <description>High speed to low power switching time in terms ofbyte clock (txbyteclkhs)</description>
          <addressOffset>0x00000064</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>LOWPWR2HI</name>
              <description>This value is based on the byte clock (txbyteclkhs) and low power clock frequency (txclkesc)LP to HS switch count = 4 * Tlpx + (programmed Tclk_prep + extracount (1 byteclk) ) + (programmed Tclk_zero + extracount (1 byteclk) ) + Tclk_pre + 2 byteclk Tlpx = Low power clock equivalence in terms of byte clock programmed in AHB reg 68h Tclk_prep = programmed value of cln_cnt_prep in AHB Reg 70h bit (7:0) Tclk_zero = programmed value of cln_cnt_zero in AHB Reg 70h bit (15:8) Tclk_pre = 8 UI Typical value x96 Number of byte clocks required to switch from low power mode to high speed mode after txrequesths_clk is asserted.</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HISPLPSW</name>
              <description>High speed to low power switching time in terms byte clock (txbyteclkhs). This value is based on the byte clock (txbyteclkhs) and low power clock frequency; HS to LP switch count = Tclk_trail + THS_Exit + 3 byteclk Tclk_trail = programmed value of cln_cnt_hs_trail in AHB Reg 70h bit (23:16) THS_Exit = programmed value of cln_cnt_hs_exit in AHB Reg 70h bit (31:24) Typical value - Number of byte clocks request to switch from high speed mode to low power mode after txrequesths_clk is de-asserted.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>LPBYTECLK</name>
          <description>Low power clock equivalence in terms of byte clock.</description>
          <addressOffset>0x00000068</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0x0000FFFF</resetMask>

          <fields>
            <field>
              <name>VALBYTECLK</name>
              <description>The value programmed in this register is equal to the number of byte clocks occupied in one low power clock; this value is based on the byte clock (txbyteclkhs) and low power clock frequency (txclkesc)</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>DPHYPARAM</name>
          <description>This field provides the timing requirement in byte clocks for the high speed preparation time.</description>
          <addressOffset>0x0000006C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0B061A04</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>HSEXIT</name>
              <description>This field provides the timing requirement in byte clocks for the high speed exit time; this corresponds to the THS-EXIT parameter specified in the DPHY specification</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HSTRAIL</name>
              <description>This field provides the timing requirement in byte clocks for the high speed trail time; this corresponds to the THS-TRAIL parameter specified in the DPHY specification</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HSZERO</name>
              <description>This field provides the timing requirement in byte clocks for the high speed drive zero time. This corresponds to the THS-ZERO parameter specified in the DPHY specification</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HSPREP</name>
              <description>This field provides the timing requirement in byte clocks for the high speed preparation time. This corresponds to the THS-PREP parameter specified in the DPHY specificaton</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>CLKLANETIMPARM</name>
          <description>This field provides the timing requirement in byte clocks</description>
          <addressOffset>0x00000070</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0B061A04</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>HSEXIT</name>
              <description>This field provides the timing requirement in byte clocks for the high speed exit time; This corresponds to the THS-EXIT parameter specified in the DPHY specification.</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HSTRAIL</name>
              <description>This field provides the timing requirement in byte clocks for the high speed trail time; This corresponds to the TCLK-TRAIL parameter specified in the DPHY  specification</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HSZERO</name>
              <description>This field provides the timing requirement in byte clocks for the high speed drive zero time; this  corresponds to the TCLK-ZERO parameter specified in the DPHY  specification</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HSPREP</name>
              <description>This field provides the timing requirement in byte corresponds to the TCLK-PREP parameter specified in the DPHY specificatio</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>RSTENBDFE</name>
          <description>This field provides the reset (enable) to the DFE</description>
          <addressOffset>0x00000074</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>ENABLE</name>
              <description>This field provides the reset (enable) to the DFE.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>AFETRIM0</name>
          <description>Afe Trim reg0</description>
          <addressOffset>0x00000078</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x1A000615</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>AFETRIM0</name>
              <description>Afe Trim reg0.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>AFETRIM1</name>
          <description>Afe Trim reg1</description>
          <addressOffset>0x0000007C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x15640152</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>AFETRIM1</name>
              <description>Afe Trim reg1.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>AFETRIM2</name>
          <description>Afe Trim reg2</description>
          <addressOffset>0x00000080</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x10000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>AFETRIM2</name>
              <description>Afe Trim reg2.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>AFETRIM3</name>
          <description>Afe Trim reg3</description>
          <addressOffset>0x00000084</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x000040F8</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>AFETRIM3</name>
              <description>Afe Trim reg3.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>ERRORAUTORCOV</name>
          <description>Errir ayti recivert register</description>
          <addressOffset>0x00000098</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000003F</resetValue>
          <resetMask>0x0000003F</resetMask>

          <fields>
            <field>
              <name>LPRXTIMEOUTCLR</name>
              <description>If this bit is set to 1, lp_rx_timeout_clr error recovery action is taken immediately by DSI TX</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HSRXTIMEOUTCLR</name>
              <description>If this bit is set to 1, Hs_rx_timeout_clr error recovery action is taken immediately by DSI TX</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LOCONTCLR</name>
              <description>If this bit is set to 1, lo_cont_clr error recovery action is taken immediately by DSI TX</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HICONTCLR</name>
              <description>If this bit is set to 1, Hi_cont_clr error recover action is taken immediately by DSI TX</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>INVLDDTCLR</name>
              <description>If this bit is set to 1, Invld_dt_clr error recovery action is taken immediately by DSI TX</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ECCMULERRCLR</name>
              <description>if this bit is set to 1, Ecc_mul_err_clr error recovery action is taken immediately by DSI TX</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>MIPIDIRDPIDIFF</name>
          <description>Mipi direction DPI difference</description>
          <addressOffset>0x0000009C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFF8001</resetMask>

          <fields>
            <field>
              <name>DPIDIFF</name>
              <description>This field provides the difference in one line time between DPI and DSI</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DPIHIGH</name>
              <description>This field provides information to check DPI line time is greater or DSI line time is greater</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LESSTHAN</name>
                  <description>one line time in DPI is less than to DSI line time</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GREATER</name>
                  <description>one line time in DPI is greater than or equal to DSI line time</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MIPIDIR</name>
              <description>This field provides the direction of MIPI bus;</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CONTROL</name>
                  <description>DSI Host has the control over MIPI bus</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RECEIVE</name>
                  <description>DSI Host is in Receive mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DATALANEPOLSWAP</name>
          <description>Data lane polarity swap register</description>
          <addressOffset>0x000000A0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000000F</resetMask>

          <fields>
            <field>
              <name>DATALNPOLSWAP</name>
              <description>Data lane Polarity sw</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LANE0</name>
                  <description>lane 0 polarity swap</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LANE1</name>
                  <description>lane 1 polarity swap</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LANE2</name>
                  <description>lane 2 polarity swap</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LANE3</name>
                  <description>lane 3 polarity swap</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ALLLANES</name>
                  <description>data lanes polarity swap</description>
                  <value>15</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>DSP</name>
      <version>1.0</version>
      <description>DSP Control Interface</description>
      <!-- <groupName>GROUP_DSP</groupName> -->
      <baseAddress>0x40100000</baseAddress>
      <size>32</size>
      <access>read-write</access>

      <addressBlock>
        <offset>0</offset>
        <size>0x0000026C</size>
        <usage>registers</usage>
      </addressBlock>

      <registers>
        <register>
          <name>MUTEX0</name>
          <description>MUTEX 0</description>
          <addressOffset>0x00000040</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000007</resetMask>

          <fields>
            <field>
              <name>MUTEX0</name>
              <description>Mutex Value (000=resource free, 001=CPU owns mutex, 010=DSP0 owns mutex, 100=DSP1 owns mutex)</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
