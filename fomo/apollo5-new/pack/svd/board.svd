              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>EMONCTRL</name>
          <description>Controls each of the energy monitor conuters</description>
          <addressOffset>0x00000200</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x000000FF</resetValue>
          <resetMask>0x0000FFFF</resetMask>

          <fields>
            <field>
              <name>CLEAR</name>
              <description>Clear the counter. Each bit corresponds to a counter. 0: Let the counter run run on its input clk. 1: Clear the counter</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>FREEZE</name>
              <description>Freeze the counter. Each bit corresponds to a counter. 0: Let the counter run. 1: Stop the counter.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>EMONCFG0</name>
          <description>The counter increments when the counter is enabled and the mode selected here matches the power mode.</description>
          <addressOffset>0x00000204</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000FF</resetMask>

          <fields>
            <field>
              <name>EMONSEL0</name>
              <description>Power modes for incrementing the counter</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NEVER</name>
                  <description>Never increment the counter</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ALWAYS</name>
                  <description>Always increment the counter</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MCUSLEEP</name>
                  <description>Increment the counter for MCU sleep mode</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MCUDEEPSLEEP</name>
                  <description>Increment the counter for MCU deepsleep mode</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DSP0ON</name>
                  <description>Increment the counter for DSP0 active mode</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DSP1ON</name>
                  <description>Increment the counter for DSP1 active mode</description>
                  <value>5</value>
                </enumeratedValue>
