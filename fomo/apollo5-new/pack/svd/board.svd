          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000208</resetValue>
          <resetMask>0x0000FFFF</resetMask>

          <fields>
            <field>
              <name>PWRACKWAITDELSIMOSTMC</name>
              <description>Default counter max for buck ST MC</description>
              <bitRange>[15:6]</bitRange>
              <access>read-write</access>

            </field>
