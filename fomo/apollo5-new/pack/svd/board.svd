          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>EHRDATA</name>
              <description>Contains the data collected in the TRNG[159_128]. Note: can only be set while in debug mode (rng_debug_enable input is set).</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>EHRDATA5</name>
