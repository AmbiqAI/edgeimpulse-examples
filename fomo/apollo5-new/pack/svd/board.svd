              <enumeratedValues>
                <enumeratedValue>
                  <name>LE</name>
                  <description>little endian</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BE</name>
                  <description>big endian</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
