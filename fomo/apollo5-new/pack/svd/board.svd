        <register>
          <name>CTRL7</name>
          <description>This includes the Control bit fields for timer 7.</description>
          <addressOffset>0x000002E0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFF03FFFF</resetMask>

          <fields>
            <field>
              <name>TMR7LMT</name>
              <description>This field decides the number of iterations of Counter/Timer 7. For Single/Repeat Patterns, it indicates number of bits to be shifted out and so, max value is 63.</description>
              <bitRange>[31:24]</bitRange>
