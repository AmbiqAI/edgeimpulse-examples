          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>CLKGENSPARES</name>
              <description>Placeholer spare registes that can be used as needed for future use</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HFRCIDLECOUNTERS</name>
          <description>Provides SW controlled # idle cycles before powering down HFRC, HFRC2., core clock enable(s)</description>
          <addressOffset>0x0000008C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x04050405</resetValue>
          <resetMask>0xBF3F3F3F</resetMask>

          <fields>
            <field>
              <name>UPDATEENABLE</name>
              <description>usage : Clear UPDATEENABLE or 1'b0; Update other bits fields of this register. Set this register to 1'b1 for HW to update.</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HFRC2CLKREQDELAY</name>
              <description>Enable for the PLL clock through clkgen</description>
              <bitRange>[29:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HFRC2PWRDOWNDELAY</name>
              <description>Idle counter for HFRC2 POWER DOWN DELAY</description>
              <bitRange>[21:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HFRCCLKREQDELAY</name>
              <description>Idle counter for HFRC CLK REQ DELAY</description>
              <bitRange>[13:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HFRCPWRDOWNDELAY</name>
              <description>Idle counter for HFRC POWER DOWN DELAY</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>INTRPTEN</name>
          <description>Set bits in this register to allow this module to generate the corresponding interrupt.</description>
          <addressOffset>0x00000100</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>OF</name>
              <description>XT Oscillator Fail interrupt</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>INTRPTSTAT</name>
          <description>Read bits from this register to discover the cause of a recent interrupt.</description>
          <addressOffset>0x00000104</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>OF</name>
              <description>XT Oscillator Fail interrupt</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>INTRPTCLR</name>
          <description>Write a 1 to a bit in this register to clear the interrupt status associated with that bit.</description>
          <addressOffset>0x00000108</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>OF</name>
              <description>XT Oscillator Fail interrupt</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>INTRPTSET</name>
          <description>Write a 1 to a bit in this register to instantly generate an interrupt from this module. (Generally used for testing purposes).</description>
          <addressOffset>0x0000010C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>OF</name>
              <description>XT Oscillator Fail interrupt</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>CPU</name>
      <version>1.0</version>
      <description>CM4 Complex Registers (Cache, TCM, DAXI)</description>
      <!-- <groupName>GROUP_CPU</groupName> -->
      <baseAddress>0x48000000</baseAddress>
      <size>32</size>
      <access>read-write</access>

      <addressBlock>
        <offset>0</offset>
        <size>0x00000228</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>CACHE</name>
        <description>CACHE_IRQ</description>
        <value>83</value>
      </interrupt>
      <interrupt>
        <name>MAX</name>
        <description>Not a valid IRQ. The maximum IRQ is this value - 1.</description>
        <value>84</value>
      </interrupt>
      <registers>
        <register>
          <name>CACHECFG</name>
          <description>CM4 Cache Control</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00103C50</resetValue>
          <resetMask>0x01103FFF</resetMask>

          <fields>
            <field>
              <name>ENABLEMONITOR</name>
              <description>Enable Cache Monitoring Stats. Cache monitoring consumes additional power and should only be enabled when profiling code and counters will increment when this bit is set. Counter values will be retained when this is set to 0, allowing software to enable/disable counting for multiple code segments.</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DATACLKGATE</name>
              <description>Enable aggressive clock gating of entire data array. This bit should be set to 1 for optimal power efficiency.</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>NC0CACHELOCK</name>
              <description>Only valid when Cache Mode D is set. When high sets the mode of the the NC0 region such that all accesse to this region are cached in to the lower half of the cache. When set low then NCR0 is non cacheable.</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>NC1CACHELOCK</name>
              <description>Only valid when Cache Mode D is set. When high sets the mode of the the NC1 region such that all accesse to this region are cached in to the upper half of the cache. When set low then NCR1 is non cacheable.</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LS</name>
              <description>Enable LS (light sleep) of cache RAMs. Software should DISABLE this bit since cache activity is too high to benefit from LS usage.</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CLKGATE</name>
              <description>Enable clock gating of cache TAG RAM. Software should enable this bit for optimal power efficiency.</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DENABLE</name>
              <description>Enable CM4 Data Caching.</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>IENABLE</name>
              <description>Enable CM4 Instruction Caching</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CONFIG</name>
              <description>Sets the cache configuration</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>W1_128B_512E</name>
                  <description>Direct mapped, 128-bit linesize, 512 entries (4 SRAMs active)</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>W2_128B_512E</name>
                  <description>Two-way set associative, 128-bit linesize, 512 entries (8 SRAMs active)</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>W1_128B_1024E</name>
                  <description>Direct mapped, 128-bit linesize, 1024 entries (8 SRAMs active)</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>W1_128B_2048E</name>
                  <description>Direct mapped, 128-bit linesize, 2048 entries (4 SRAMs active)</description>
                  <value>12</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>W2_128B_2048E</name>
                  <description>Two-way set associative, 128-bit linesize, 2048 entries (8 SRAMs active)</description>
                  <value>13</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>W1_128B_4096E</name>
                  <description>Direct mapped, 128-bit linesize, 4096 entries (8 SRAMs active)</description>
                  <value>14</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>NC1ENABLE</name>
              <description>Enable Non-cacheable region 1. See NCR1 registers to define the region.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>NC0ENABLE</name>
              <description>Enable Non-cacheable region 0. See NCR0 registers to define the region.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LRU</name>
              <description>Sets the cache repleacment policy. 0=LRR (least recently replaced), 1=LRU (least recently used). LRR minimizes writes to the TAG SRAM.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ENABLE</name>
              <description>Enables the CM4 cache controller and enables power to the cache SRAMs. The ICACHE_ENABLE and DCACHE_ENABLE should be set to enable caching for each type of access.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>CACHECTRL</name>
          <description>Cache Control</description>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000007</resetMask>

          <fields>
            <field>
              <name>CACHEREADY</name>
              <description>Cache Ready Status (enabled and not processing an invalidate operation)</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RESETSTAT</name>
              <description>Reset Cache Statistics. When written to a 1, the cache monitor counters will be cleared. The monitor counters can be reset only when the CACHECFG.ENABLE_MONITOR bit is set.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Clear Cache Stats</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DEFAULT</name>
                  <description>default Cache Stats</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>INVALIDATE</name>
              <description>Writing a 1 to this bitfield invalidates the CM4 cache contents.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>NCR0START</name>
          <description>CM4 Cache Noncachable Region 0 Start</description>
          <addressOffset>0x00000010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x1FFFFFF0</resetMask>

          <fields>
            <field>
              <name>ADDR</name>
              <description>Start address for non-cacheable region 0</description>
              <bitRange>[28:4]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>NCR0END</name>
          <description>CM4 Cache Noncachable Region 0 End</description>
          <addressOffset>0x00000014</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x1FFFFFF0</resetMask>

          <fields>
            <field>
              <name>ADDR</name>
              <description>End address for non-cacheable region 0</description>
              <bitRange>[28:4]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>NCR1START</name>
          <description>CM4 Cache Noncachable Region 1 Start</description>
          <addressOffset>0x00000018</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x1FFFFFF0</resetMask>

          <fields>
            <field>
              <name>ADDR</name>
              <description>Start address for non-cacheable region 1</description>
              <bitRange>[28:4]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>NCR1END</name>
          <description>CM4 Cache Noncachable Region 1 End</description>
          <addressOffset>0x0000001C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x1FFFFFF0</resetMask>

          <fields>
            <field>
              <name>ADDR</name>
              <description>End address for non-cacheable region 1</description>
              <bitRange>[28:4]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>DAXICFG</name>
          <description>DAXI Config</description>
          <addressOffset>0x00000050</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x000B0300</resetValue>
          <resetMask>0x031F0F3F</resetMask>

          <fields>
            <field>
              <name>MRUGROUPLEVEL</name>
              <description>Sets the MRU group population limit.</description>
              <bitRange>[25:24]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MAX</name>
                  <description>Maximum level for current number of buffers enabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ONELESSTHANMAX</name>
                  <description>One less than maximum level or zero for current number of buffers enabled.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TWOLESSTHANMAX</name>
                  <description>Two less than maximum level or zero for current number of buffers enabled.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THREELESSTHANMAX</name>
                  <description>Three less than maximum level or zero for current number of buffers enabled.</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>AGINGCOUNTER</name>
              <description>Specifies the relative time that DAXI buffers may remain unused before being flushed. Counter is based on CPU clock cycles and buffers will generally be flushed in 1-2 AGINGCOUNTER timesteps.</description>
              <bitRange>[20:16]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ONE</name>
                  <description>One step per age</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TWO</name>
                  <description>Two steps per age</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FOUR</name>
                  <description>Four steps per age</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EIGHT</name>
                  <description>EIGHT steps per age</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SIXTEEN</name>
                  <description>Sixteen steps per age</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THIRTYTWO</name>
                  <description>Thirty-two steps per age</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SIXTYFOUR</name>
                  <description>64 steps per age</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ONEHUNDREDTWENTYEIGHT</name>
                  <description>One hundred twenty-eight steps per age</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TWOHUNDEREDFIFTYSIX</name>
                  <description>Two hundred fifty-six steps per age</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FIVEHUNDREDTWELVE</name>
                  <description>Five hundred twelve steps per age</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ONEK</name>
                  <description>One thousand twenty-four steps per age</description>
                  <value>10</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TWOK</name>
                  <description>Two thousand forty-eight steps per age</description>
                  <value>11</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FOURK</name>
                  <description>Four thousand ninety-six steps per age</description>
                  <value>12</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EIGHTK</name>
                  <description>Eight thousand one hundred ninety-two steps per age</description>
                  <value>13</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SIXTEENK</name>
                  <description>Sixteen thousand three hundred eighty-four steps per age</description>
                  <value>14</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THIRTYTWOK</name>
                  <description>Thirty-two thousand seven hundred sixty-eight steps per age</description>
                  <value>15</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SIXTYFOURK</name>
                  <description>Sixty-fix thousand five hundred thirty-six steps per age</description>
                  <value>16</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BUFFERENABLE</name>
              <description>Enables DAXI buffers</description>
              <bitRange>[11:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ONE</name>
                  <description>One buffer mode enabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TWO</name>
                  <description>Two buffers enabled.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THREE</name>
                  <description>Three buffers enabled.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FOUR</name>
                  <description>Four buffers enabled.</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FIVE</name>
                  <description>Five buffers enabled.</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SIX</name>
                  <description>Six buffers enabled.</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SEVEN</name>
                  <description>Seven buffers enabled.</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EIGHT</name>
                  <description>Eight buffers enabled.</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THIRTEEN</name>
                  <description>Eight buffers enabled.</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FOURTEEN</name>
                  <description>Eight buffers enabled.</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FIFTEEN</name>
                  <description>Eight buffers enabled.</description>
                  <value>10</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SIXTEEN</name>
                  <description>Eight buffers enabled.</description>
                  <value>11</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TWENTYNINE</name>
                  <description>Twenty-nine buffers enabled.</description>
                  <value>12</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THIRTY</name>
                  <description>Thirty buffers enabled.</description>
                  <value>13</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THIRTYONE</name>
                  <description>Thirty-one buffers enabled.</description>
                  <value>14</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THIRTYTWO</name>
                  <description>Thirty-two buffers enabled.</description>
                  <value>15</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DAXISTATECLKGATEEN</name>
              <description>Enables clock gating of DAXI state.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable clock gating of DAXI state.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable clock gating of DAXI state.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DAXIDATACLKGATEEN</name>
              <description>Enables clock gating of DAXI line buffer data.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable clock gating of DAXI line buffer data.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable clock gating of DAXI line buffer data.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DAXIBECLKGATEEN</name>
              <description>Enables clock gating of DAXI line buffer byte enables.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable clock gating of DAXI line buffer byte enables.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable clock gating of DAXI line buffer byte enables.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DAXIPASSTHROUGH</name>
              <description>Passes requests through DAXI logic, disables caching lines in the DAXI line buffers.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable pass through mode, caching lines in DAXI enabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable pass through mode, caching lines in DAXI disabled.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>AGINGSENABLE</name>
              <description>Enables flushing out shared lines using the aging mechanism.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Flushing out shared entries using aging mechanism disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Flushing out shared entries using aging mechanism enabled.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FLUSHLEVEL</name>
              <description>Level of free buffers to flush out dirty buffers.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TWO</name>
                  <description>Flush out dirty buffers if 3 or more ane enabled and less than two are free or if 2 are enabled and none are free.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THREE</name>
                  <description>Flush out dirty buffers if 3 or more are enabled less than three are free or if 2 are enabled and less then two are free.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DAXICTRL</name>
          <description>DAXI Control</description>
          <addressOffset>0x00000054</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000004</resetValue>
          <resetMask>0x00001FFF</resetMask>

          <fields>
            <field>
              <name>DAXIRAXIBUSY</name>
              <description>DAXI status indicating the DAXI RAXI interface is busy.</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DAXIBRESPPENDING</name>
              <description>DAXI status indicating at least one AXI B repsonse for a store is pending.</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DAXISTORE</name>
              <description>DAXI status indicating at least one buffer has outstanding store waiting to complete.</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DAXIWRLOAD</name>
              <description>DAXI status indicating at least one partially written buffer is waiting for load to convert to modified.</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DAXIWALLOC</name>
              <description>DAXI status indicating at least one write allocation is waiting for prior store to complete.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DAXIWRITE</name>
              <description>DAXI status indicating at least one partially written buffer has modified data.</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DAXIMODIFIED</name>
              <description>DAXI status indicating at least one full buffer has modified data.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DAXISHARED</name>
              <description>DAXI status indicating at least one full buffer is shared.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DAXIAHBBUSY</name>
              <description>DAXI status indicating DAXI AHB interface is busy.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DAXIBUSY</name>
              <description>DAXI status indicating DAXI is busy.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DAXIREADY</name>
              <description>DAXI Ready Status (enabled and not processing a flush of WRITE or MODIFIED buffers)</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DAXIINVALIDATE</name>
              <description>Writing a 1 to this bitfield invalidates any SHARED data buffers (S->I).</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DAXIFLUSHWRITE</name>
              <description>Writing a 1 to this bitfield forces a flush of WRITE (W->I) or MODIFIED buffers (M->S).</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>ICODEFAULTADDR</name>
          <description>ICODE bus address which was present when a bus fault occurred.</description>
          <addressOffset>0x00000080</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>ICODEFAULTADDR</name>
              <description>The ICODE bus address observed when a Bus Fault occurred. Once an address is captured in this field, it is held until the corresponding Fault Observed bit is cleared in the FAULTSTATUS register.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>DCODEFAULTADDR</name>
          <description>DCODE bus address which was present when a bus fault occurred.</description>
          <addressOffset>0x00000084</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>DCODEFAULTADDR</name>
              <description>The DCODE bus address observed when a Bus Fault occurred. Once an address is captured in this field, it is held until the corresponding Fault Observed bit is cleared in the FAULTSTATUS register.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>SYSFAULTADDR</name>
          <description>System bus address which was present when a bus fault occurred.</description>
          <addressOffset>0x00000088</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>SYSFAULTADDR</name>
              <description>SYS bus address observed when a Bus Fault occurred. Once an address is captured in this field, it is held until the corresponding Fault Observed bit is cleared in the FAULTSTATUS register.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>FAULTSTATUS</name>
          <description>Reflects the status of the bus decoders' fault detection. Any write to this register will clear all of the status bits within the register.</description>
          <addressOffset>0x0000008C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000007</resetMask>

          <fields>
            <field>
              <name>SYSFAULT</name>
              <description>SYS Bus Decoder Fault Detected bit. When set, a fault has been detected, and the SYSFAULTADDR register will contain the bus address which generated the fault.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOFAULT</name>
                  <description>No bus fault has been detected.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FAULT</name>
                  <description>Bus fault detected.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DCODEFAULT</name>
              <description>DCODE Bus Decoder Fault Detected bit. When set, a fault has been detected, and the DCODEFAULTADDR register will contain the bus address which generated the fault.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOFAULT</name>
                  <description>No DCODE fault has been detected.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FAULT</name>
                  <description>DCODE fault detected.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ICODEFAULT</name>
              <description>The ICODE Bus Decoder Fault Detected bit. When set, a fault has been detected, and the ICODEFAULTADDR register will contain the bus address which generated the fault.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOFAULT</name>
                  <description>No ICODE fault has been detected.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FAULT</name>
                  <description>ICODE fault detected.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>FAULTCAPTUREEN</name>
          <description>Enable the fault capture registers</description>
          <addressOffset>0x00000090</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>FAULTCAPTUREEN</name>
              <description>Fault Capture Enable field. When set, the Fault Capture monitors are enabled and addresses which generate a hard fault are captured into the FAULTADDR registers.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable fault capture.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable fault capture.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
