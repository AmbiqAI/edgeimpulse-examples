                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FRC</name>
                  <description>Force HFRC2 on; runs in deep sleep mode.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
