                  <name>LOWPWR</name>
                  <description>Low power state.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HFRCDIV2</name>
                  <description>Selects HFRC divided by 2 as the source dbg ts clk</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HFRCDIV8</name>
                  <description>Selects HFRC divided by 8 as the source dbg ts clk</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HFRCDIV16</name>
                  <description>Selects HFRC divided by 16 as the source dbg ts clk</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HFRCDIV32</name>
                  <description>Selects HFRC divided by 32 as the source dbg ts clk</description>
                  <value>4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DBGDSP1TRACEEN</name>
              <description>Debug subsystem DSP1 trace enable</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable DSP1 trace.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable DSP1 trace.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DBGDSP0TRACEEN</name>
