            </field>
            <field>
              <name>RSVD1</name>
              <description>This bitfield is reserved.</description>
              <bitRange>[29:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DISCLKCORE</name>
              <description>disable clock gating for core 0</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RSVD0</name>
              <description>This bitfield is reserved.</description>
              <bitRange>[22:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DISCLKFRAME</name>
              <description>disable clock gating for framebuffer 0 (MISTAKE ?)</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DISCLKCFG</name>
              <description>disable clock gating for configuration file</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DISCLKPROC</name>
              <description>disable clock gating for command list processor</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
