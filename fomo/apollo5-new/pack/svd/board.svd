              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>TMR13CMP0</name>
          <description>This contains the Compare limits for timer 13. This is the primary comparator that can be used to mark the END of a timer cycle (and thus restart the timer for repeat modes)</description>
          <addressOffset>0x000003A8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>TMR13CMP0</name>
              <description>Counter/Timer 13 End Compare Register. For MEASURE mode indicates the high phase sample count.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>TMR13CMP1</name>
          <description>This comparator is used as a secondary compare count for modes that generate pulses. For MEASURE mode indicates the low phase sample count.</description>
          <addressOffset>0x000003AC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>TMR13CMP1</name>
              <description>Holds the secondary comparator that can be used to generate a PWM or generate secondary pulses. CMP0 should ALWAYS be used first.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>MODE13</name>
          <description>The mode register contains optional mode controls for the timer</description>
          <addressOffset>0x000003B0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FF00</resetMask>

          <fields>
            <field>
              <name>TMR13TRIGSEL</name>
              <description>Counter/Timer 13 Trigger Source Selection</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TMR00</name>
                  <description>Trigger source is TIMER 0 Output 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TMR01</name>
                  <description>Trigger source is TIMER 0 Output 1</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
