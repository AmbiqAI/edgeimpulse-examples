          <access>read-write</access>
          <resetValue>0x00000010</resetValue>
          <resetMask>0x0001FBFF</resetMask>

          <fields>
            <field>
              <name>ADCKEEPOUTEN</name>
              <description>ADC reference keeper out en</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ADCRFBUFSLWEN</name>
              <description>ADC reference buffer slew enable</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ADCINBUFEN</name>
              <description>ADC Input Buffer Power Enable ( if the ADCPWRCTRLSWE bit is set )</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ADCINBUFSEL</name>
              <description>ADC input buffer mux select</description>
              <bitRange>[13:12]</bitRange>
              <access>read-write</access>

            </field>
