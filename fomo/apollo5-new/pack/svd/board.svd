                  <description>Power up PDM1</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Power down PDM1</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRENPDM0</name>
              <description>Power up audio subsystem PDM0 domain</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Power up PDM0</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Power down PDM0</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRENAUDPB</name>
              <description>Power up Audio Playback</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Power up AUDPB</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Power down AUDPB</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRENAUDREC</name>
              <description>Power up Audio Record</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Power up AUDREC</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Power down AUDREC</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>AUDSSPWRSTATUS</name>
          <description>This provides the power status for the peripheral domains controlled through AUDSSPWREN register. Value of 1 means the device is powred up and ready to be used and 0 means its not powered up.</description>
          <addressOffset>0x00000010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000CFF</resetMask>

          <fields>
            <field>
              <name>PWRSTDSPA</name>
              <description>Power Status DSPA subsystem</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ON</name>
                  <description>Domain powered on</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Domain powered off</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRSTAUDADC</name>
              <description>Power Status audio subsystem ADC domain</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ON</name>
                  <description>Domain powered on</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Domain powered off</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRSTI2S1</name>
              <description>Power Status audio subsystem I2S1 domain</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ON</name>
                  <description>Domain powered on</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Domain powered off</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRSTI2S0</name>
              <description>Power Status audio subsystem I2S0 domain</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ON</name>
                  <description>Domain powered on</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Domain powered off</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRSTPDM3</name>
              <description>Power Status audio subsystem PDM3 domain</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ON</name>
                  <description>Domain powered on</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Domain powered off</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRSTPDM2</name>
              <description>Power Status audio subsystem PDM2 domain</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ON</name>
                  <description>Domain powered on</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Domain powered off</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRSTPDM1</name>
              <description>Power Status audio subsystem PDM1 domain</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ON</name>
                  <description>Domain powered on</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Domain powered off</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRSTPDM0</name>
              <description>Power Status audio subsystem PDM0 domain</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ON</name>
                  <description>Domain powered on</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Domain powered off</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRSTAUDPB</name>
              <description>Power Status Audio Playback block</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ON</name>
                  <description>Domain powered on</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Domain powered off</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRSTAUDREC</name>
              <description>Power Status Audio Record block</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ON</name>
                  <description>Domain powered on</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Domain powered off</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>MEMPWREN</name>
          <description>This register enables the individual banks for the memories. When set, power will be enabled to the banks. This register works in conjunction with the MEMRETCFG register. If this register is not set, then power will always be disabled to the memory bank.</description>
          <addressOffset>0x00000014</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000003F</resetValue>
          <resetMask>0x0000003F</resetMask>

          <fields>
            <field>
              <name>PWRENCACHEB2</name>
              <description>Power up Cache Bank 2. This works in conjunction with Cache enable from flash_cache module. To power up cache bank2, cache has to be enabled and this bit has to be set.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Power up Cache Bank 2</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Power down Cache Bank 2</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRENCACHEB0</name>
              <description>Power up Cache Bank 0. This works in conjunction with Cache enable from flash_cache module. To power up cache bank0, cache has to be enabled and this bit has to be set.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Power up Cache Bank 0</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Power down Cache Bank 0</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRENNVM0</name>
              <description>Power up NVM0</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Power up NVM0</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Power down NVM0</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRENDTCM</name>
              <description>Power up DTCM</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NONE</name>
                  <description>Do not enable power to any DTCMs</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TCM8K</name>
                  <description>Power ON only lower 8k</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TCM128K</name>
                  <description>Power ON only lower 128k</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TCM384K</name>
                  <description>Power ON 384k</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>MEMPWRSTATUS</name>
          <description>It provides the power status for all the memory banks including- caches, nvm (0 and 1) and all the SRAM groups. The status here should reflect the enable provided by the MEMPWREN register. There may be a lag time between setting the bits in MEMPWREN register and MEMPWRSTATUS register, due to the need to cycle the power gate and isolation seqeunces to the memory banks.</description>
          <addressOffset>0x00000018</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000003F</resetValue>
          <resetMask>0x0000003F</resetMask>

          <fields>
            <field>
              <name>PWRSTCACHEB2</name>
              <description>This bit is 1 if power is supplied to Cache Bank 2</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>PWRSTCACHEB0</name>
              <description>This bit is 1 if power is supplied to Cache Bank 0</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>PWRSTNVM0</name>
              <description>This bit is 1 if power is supplied to NVM 0</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>PWRSTDTCM</name>
              <description>Power status for DTCM. Each bit corresponds to one of the TCMs. bit0=DTCM0_0, bit1=DTCM0_1, bit2=DTCM1.</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NONE</name>
                  <description>Do not enable power to any DTCMs</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TCM8K</name>
                  <description>Only lower 8k is powered up</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TCM128K</name>
                  <description>Only lower 128k is powered up</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TCM384K</name>
                  <description>All 384k is powered up</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>MEMRETCFG</name>
          <description>This controls the power down of the SRAM banks in deep sleep mode. If this is set, then the power for that SRAM bank will be gated when the core goes into deep sleep. Upon wake, the data within the SRAMs will be erased. If this is not set, retention voltage will be applied to the SRAM bank when the core goes into deep sleep. Upon wake, the data within the SRAMs are retained. Do not set this if the SRAM bank is used as the target for DMA transfer while CPU in deepsleep.</description>
          <addressOffset>0x0000001C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000008</resetValue>
          <resetMask>0x0000001F</resetMask>

          <fields>
            <field>
              <name>CACHEPWDSLP</name>
              <description>power down cache in deep sleep</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Power down cache in deep sleep</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Retain cache in deep sleep</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>NVM0PWDSLP</name>
              <description>Powerdown NVM0 in deep sleep</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>NVM0 is powered down during deepsleep</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>NVM0 is kept powered on during deepsleep</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DTCMPWDSLP</name>
              <description>power down DTCM in deep sleep</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NONE</name>
                  <description>All DTCM retained</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GROUP0DTCM0</name>
                  <description>Group0_DTCM0 powered down in deep sleep (0KB-8KB)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GROUP0DTCM1</name>
                  <description>Group0_DTCM1 powered down in deep sleep (8KB-128KB)</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GROUP0</name>
                  <description>Both DTCMs in group0 are powered down in deep sleep (0KB-128KB)</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ALLBUTGROUP0DTCM0</name>
                  <description>Group1 and Group0_DTCM1 are powered down in deep sleep (8KB-384KB)</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GROUP1</name>
                  <description>Group1 DTCM powered down in deep sleep (128KB-384KB)</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ALL</name>
                  <description>All DTCMs powered down in deep sleep (0KB-384KB)</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>SYSPWRSTATUS</name>
          <description>Power ON Status for domains that are not part of devpwrstatus or mempwrstatus</description>
          <addressOffset>0x00000020</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000000F</resetValue>
          <resetMask>0xE000000F</resetMask>

          <fields>
            <field>
              <name>SYSDEEPSLEEP</name>
              <description>Indicates all device domains powered down and MCU entered DEEPSLEEP state since it was last cleared. Write 1 to to clear it.</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>COREDEEPSLEEP</name>
              <description>Indicates MCU entered DEEPSLEEP state since it was last cleared. Write 1 to to clear it.</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CORESLEEP</name>
              <description>Indicates MCU entered SLEEP state since it was last cleared. Write 1 to to clear it.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>PWRSTDSP1H</name>
              <description>Power Domain status for DSP1H</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>PWRSTDSP0H</name>
              <description>Power Domain status for DSP0H</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>PWRSTMCUH</name>
              <description>Power Domain status for MCUH</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>PWRSTMCUL</name>
              <description>Power Domain status for MCUL</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>SSRAMPWREN</name>
          <description>This register enables the individual banks for the memories. When set, power will be enabled to the banks. This register works in conjunction with the SSRAMRETCFG register. If this register is not set, then power will always be disabled to the memory bank.</description>
          <addressOffset>0x00000024</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000003</resetMask>

          <fields>
            <field>
              <name>PWRENSSRAM</name>
              <description>Power up SRAM groups</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NONE</name>
                  <description>Do not power ON any of the SRAM banks</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GROUP0</name>
                  <description>Power ON only SRAM0 group (lower 1M)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GROUP1</name>
                  <description>Power ON only SRAM1 group (upper 1M)</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ALL</name>
                  <description>All shared SRAM banks (SSRAM0 1M + SSRAM1 1M) powered ON</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>SSRAMPWRST</name>
          <description>It provides the power status for shared sram banks. The status here should reflect the enable provided by the SSRAMPWREN register.</description>
          <addressOffset>0x00000028</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000003</resetValue>
          <resetMask>0x00000003</resetMask>

          <fields>
            <field>
              <name>SSRAMPWRST</name>
              <description>Each bit corresponds to one 1M SSRAM group.  Power Status- 1:ON, 0:OFF  See SSRAMPWREN PWRENSSRAM for bit mapping. For example, a value of 2 in this field would mean that SSRAM1 is powered up and SSRAM0 is powered down.</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>SSRAMRETCFG</name>
          <description>This controls the power down of the Shared SRAM banks in deep sleep mode. If this is set, then the power for that SRAM bank will be gated when the core goes into deep sleep. Upon wake, the data within the SRAMs will be erased. If this is not set, retention voltage will be applied to the SRAM bank when none of the CPU agents are in powered up and active mode. Do not set this if the SRAM bank is used as the target for DMA transfer while CPU in deepsleep.</description>
          <addressOffset>0x0000002C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x000003FC</resetValue>
          <resetMask>0x000003FF</resetMask>

          <fields>
            <field>
              <name>SSRAMACTDISP</name>
              <description>Keep the memory domain active based on DISP state. Each bit corresponds to a domain. 1: Keep SRAM active 0: Powerup on demand (i.e. when DISP is powered up)</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>SSRAMACTGFX</name>
              <description>Keep the memory domain active based on GFX state. Each bit corresponds to a domain. 1: Keep SRAM active 0: Powerup on demand (i.e. when GFX is powered up)</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>SSRAMACTDSP</name>
              <description>Keep the memory domain active based on DSP state. Each bit corresponds to a domain. 1: Keep SRAM active 0: Powerup on demand (i.e. when DSP is powered up)</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>SSRAMACTMCU</name>
              <description>Keep the memory domain active based on MCU state. Each bit corresponds to a domain. 1: Keep SRAM active 0: Wakeup on demand (i.e. when MCU is powered up)</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>SSRAMPWDSLP</name>
              <description>Selects which shared SRAM banks are powered down in deep sleep mode, causing the contents of the bank to be lost.</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NONE</name>
                  <description>All banks retained</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GROUP0</name>
                  <description>Power down only SRAM group0</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GROUP1</name>
                  <description>Power down only SRAM group1</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ALL</name>
                  <description>All shared SRAM banks powered down</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVPWREVENTEN</name>
          <description>This register controls which feature trigger will result in an event to the CPU. It includes all the power on status for the core domains. If any bits are set, then if the domain is turned on, it will result in an event to the ARM core.</description>
          <addressOffset>0x00000030</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000FF</resetMask>

          <fields>
            <field>
              <name>AUDEVEN</name>
              <description>Control AUD power-on status event</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable AUD power-on status event</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable AUD power-on status event</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MSPIEVEN</name>
              <description>Control MSPI power-on status event</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable MSPI power-on status event</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable MSPI power-on status event</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADCEVEN</name>
              <description>Control ADC power-on status event</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable ADC power-on status event</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable ADC power-on status event</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HCPCEVEN</name>
              <description>Control HCPC power-on status event</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable HCPC power-on status event</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable HCPC power-on status event</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HCPBEVEN</name>
              <description>Control HCPB power-on status event</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable HCPB power-on status event</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable HCPB power-on status event</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HCPAEVEN</name>
              <description>Control HCPA power-on status event</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable HCPA power-on status event</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable HCPA power-on status event</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MCUHEVEN</name>
              <description>Control MCUH power-on status event</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable MCHU power-on status event</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable MCUH power-on status event</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MCULEVEN</name>
              <description>Control MCUL power-on status event</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable MCUL power-on status event</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable MCUL power-on status event</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>MEMPWREVENTEN</name>
          <description>This register controls which power enable for the memories will result in an event to the CPU. It includes all the power on status for the memory domains. If any bits are set, then if the domain is turned on, it will result in an event to the ARM core.</description>
          <addressOffset>0x00000034</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000003F</resetMask>

          <fields>
            <field>
              <name>CACHEB2EN</name>
              <description>Control CACHEB2 power-on status event</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable CACHE BANK 2 status event</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable CACHE BANK 2 status event</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CACHEB0EN</name>
              <description>Control CACHE BANK 0 power-on status event</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable CACHE BANK 0 status event</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable CACHE BANK 0 status event</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>NVM0EN</name>
              <description>Control NVM power-on status event</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable NVM status event</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disables NVM status event</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DTCMEN</name>
              <description>Enable DTCM power-on status event</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NONE</name>
                  <description>Do not enable DTCM power-on status event</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GROUP0DTCM0EN</name>
                  <description>Enable GROUP0_DTCM0 power on status event</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GROUP0DTCM1EN</name>
                  <description>Enable GROUP0_DTCM1 power on status event</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GROUP0EN</name>
                  <description>Enable DTCMs in group0 power on status event</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GROUP1EN</name>
                  <description>Enable DTCMs in group1 power on status event</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ALL</name>
                  <description>Enable all DTCM power on status event</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>MMSOVERRIDE</name>
          <description>Power domain behavior overrides related to MMS ( Multimedia System ).</description>
          <addressOffset>0x00000040</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000FFC</resetValue>
          <resetMask>0x00000FFF</resetMask>

          <fields>
            <field>
              <name>MMSOVRSSRAMRETGFX</name>
              <description>If set, retention equation doesn't consider GFX. Each bit corresponds to a domain.</description>
              <bitRange>[11:10]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ALWAYSON</name>
                  <description>When PD_GFX is off, retention is always okay for PD_GFX domain.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PGSTATE</name>
                  <description>When PD_GFX is off, retention is okay based on the state of PD_GFX domain and SSRAMRETCFG.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MMSOVRSSRAMRETDISP</name>
              <description>If set, retention equation doesn't consider DISP. Each bit corresponds to a domain.</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ALWAYSON</name>
                  <description>When PD_DISP is off, retention is always okay for PD_DISP domain.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PGSTATE</name>
                  <description>When PD_DISP is off, retention is okay based on the state of PD_DISP domain and SSRAMRETCFG.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MMSOVRDSPRAMRETGFX</name>
              <description>If set, retention equation doesn't consider GFX. Each bit corresponds to a domain.</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ALWAYSON</name>
                  <description>When PD_GFX is off, retention is always okay for PD_GFX domain.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PGSTATE</name>
                  <description>When PD_GFX is off, retention is okay based on the state of PD_GFX domain and DSP[1|0]MEMRETCFG.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MMSOVRDSPRAMRETDISP</name>
              <description>If set, retention equation doesn't consider DISP. Each bit corresponds to a domain.</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ALWAYSON</name>
                  <description>When PD_DISP is off, retention is always okay for PD_DISP domain.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PGSTATE</name>
                  <description>When PD_DISP is off, retention is okay based on the state of PD_DISP domain and DSP[1|0]MEMRETCFG.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MMSOVRSSRAMGFX</name>
              <description>MMS override for SSRAM power state by PD_GFX power setting.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOGFX</name>
                  <description>SSRAM power state is not affected by PD_GFX setting.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PD_GFX</name>
                  <description>SSRAM power state set by SSRAMPWREN_PWRENSSRAM is overridden by PD_GFX setting.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MMSOVRSSRAMDISP</name>
              <description>MMS override for SSRAM power state by PD_DISP power setting.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NODISP</name>
                  <description>SSRAM power state is not affected by PD_DISP setting.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PD_DISP</name>
                  <description>SSRAM power state set by SSRAMPWREN_PWRENSSRAM is overridden by PD_DISP setting.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MMSOVRMCULGFX</name>
              <description>MMS override for MCUL on by PD_GFX setting.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MCULON</name>
                  <description>When PD_GFX is on, MCUL is on.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MCULOFF</name>
                  <description>When PD_GFX is on, MCUL is still off.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MMSOVRMCULDISP</name>
              <description>MMS override for MCUL on by PD_DISP setting.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MCULON</name>
                  <description>When PD_DISP is on, MCUL is on.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MCULOFF</name>
                  <description>When PD_DISP is on, MCUL is still off.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DSP0PWRCTRL</name>
          <description>Power and RST controls for DSP0</description>
          <addressOffset>0x00000050</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000008</resetValue>
          <resetMask>0x0000001F</resetMask>

          <fields>
            <field>
              <name>DSP0PCMRSTOR</name>
              <description>PCM Reset override. If this is disabled, then h/w will handle the de-assertion of pcm reset.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Keep DSP0 PCM in Reset</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Remove DSP0 PCM Reset override</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DSP0PCMRSTDLY</name>
              <description>PCM Reset delay in number of 24MHz clocks.</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>DSP0PERFREQ</name>
          <description>This register provides the performance mode knobs for DSP0. S/w should write the *PERFREQ field to desired mode and wait for the *PERFACK and check for the *PERFSTATUS. Some times system may not allow certain modes but *PERFACK should always follow *PERFREQ change.</description>
          <addressOffset>0x00000054</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000009</resetValue>
          <resetMask>0x0000001F</resetMask>

          <fields>
            <field>
              <name>DSP0PERFSTATUS</name>
              <description>DSP0 Performance mode request</description>
              <bitRange>[4:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ULP</name>
                  <description>DSP0 is in ULP mode (freq=48MHz)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LP</name>
                  <description>DSP0 is in LP mode (freq=192MHz)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HP</name>
                  <description>DSP0 is in HP mode (freq=384MHz)</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DSP0PERFACK</name>
              <description>Indicates the DSP0 performance status indicated in STATUS register is valid.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DSP0PERFREQ</name>
              <description>DSP0 Performance mode request</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ULP</name>
                  <description>DSP0 to be run in ULP mode (freq=48MHz)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LP</name>
                  <description>DSP0 to be run in LP mode (freq=192MHz)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HP</name>
                  <description>DSP0 to be run in HP mode (freq=384MHz)</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DSP0MEMPWREN</name>
          <description>This register enables the individual banks for the memories. When set, power will be enabled to the banks. This register works in conjunction with the DSP0MEMRETCFG register when DSP0 is OFF.</description>
          <addressOffset>0x00000058</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000003</resetMask>

          <fields>
            <field>
              <name>PWRENDSP0ICACHE</name>
              <description>Power up DSP0 ICACHE banks</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Do not power up ICACHE</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ON</name>
                  <description>Power up ICACHE</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRENDSP0RAM</name>
              <description>Power up DSP0 IRAM and DRAM</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Do not power ON any of the IRAM/DRAM</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ON</name>
                  <description>Power up all IRAM (128K) and DRAM (256K)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DSP0MEMPWRST</name>
          <description>It provides the power status for all the memories of DSP0 subsystem</description>
          <addressOffset>0x0000005C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000003</resetMask>

          <fields>
            <field>
              <name>PWRSTDSP0ICACHE</name>
              <description>Power Status- 1:ON, 0:OFF</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>PWRSTDSP0RAM</name>
              <description>Status- 1:ON, 0:OFF</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>DSP0MEMRETCFG</name>
          <description>This controls the power down of the DRAM/IRAM/CACHE banks when DSP0 is powered off. If this is set, then the power for that corresponding SRAM bank will be gated when the DSP0 is powered off and data is erased. If this is not set, retention voltage will be applied when DSP0 is powered off. Do not set this if the SRAM bank is used as the target for DMA transfer while DSP0 is powered off.</description>
          <addressOffset>0x00000060</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000001F</resetMask>

          <fields>
            <field>
              <name>DSP0RAMACTGFX</name>
              <description>Keep the memory domain active based on GFX state.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WAKEONDEMAND</name>
                  <description>Wakeup on demand</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACT</name>
                  <description>Keep RAMs active irrespective of GFX state</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DSP0RAMACTDISP</name>
              <description>Keep the memory domain active based on DISP state.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WAKEONDEMAND</name>
                  <description>Wakeup on demand</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACT</name>
                  <description>Keep RAMs active irrespective of DISP state</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ICACHEPWDDSP0OFF</name>
              <description>ICACHE is powered down when DSP0 is switched off, causing the contents of the bank to be lost.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RET</name>
                  <description>ICACHE retained</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWD</name>
                  <description>Power down ICACHE</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DSP0RAMACTMCU</name>
              <description>Keep the memory domain active based on MCU state.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WAKEONDEMAND</name>
                  <description>Wakeup on demand</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACT</name>
                  <description>Keep RAMs active irrespective of MCU state</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RAMPWDDSP0OFF</name>
              <description>IRAM/DRAM banks are powered down when DSP0 is switched off, causing the contents of the bank to be lost.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RET</name>
                  <description>IRAM and DRAM retained</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWD</name>
                  <description>Power down all IRAM and DRAM</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DSP1PWRCTRL</name>
          <description>Power and RST controls for DSP1</description>
          <addressOffset>0x00000070</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000008</resetValue>
          <resetMask>0x0000001F</resetMask>

          <fields>
            <field>
              <name>DSP1PCMRSTOR</name>
              <description>PCM Reset override. If this is disabled, then h/w will handle the de-assertion of pcm reset.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Keep DSP1 PCM in Reset</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Remove DSP1 PCM Reset override</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DSP1PCMRSTDLY</name>
              <description>PCM Reset delay in number of 24MHz clocks.</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>DSP1PERFREQ</name>
          <description>This register provides the performance mode knobs for DSP1. S/w should write the *PERFREQ field to desired mode and wait for the *PERFACK and check for the *PERFSTATUS. Some times system may not allow certain modes but *PERFACK should always follow *PERFREQ change.</description>
          <addressOffset>0x00000074</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000009</resetValue>
          <resetMask>0x0000001F</resetMask>

          <fields>
            <field>
              <name>DSP1PERFSTATUS</name>
              <description>DSP1 Performance mode request</description>
              <bitRange>[4:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ULP</name>
                  <description>DSP1 is in ULP mode (freq=48MHz)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LP</name>
                  <description>DSP1 is in LP mode (freq=192MHz)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HP</name>
                  <description>DSP1 is in HP mode (freq=384MHz)</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DSP1PERFACK</name>
              <description>Indicates the DSP1 performance status indicated in STATUS register is valid.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DSP1PERFREQ</name>
              <description>DSP1 Performance mode request</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ULP</name>
                  <description>DSP1 to be run in ULP mode (freq=48MHz)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LP</name>
                  <description>DSP1 to be run in LP mode (freq=192MHz)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HP</name>
                  <description>DSP1 to be run in HP mode (freq=384MHz)</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DSP1MEMPWREN</name>
          <description>This register enables the individual banks for the memories. When set, power will be enabled to the banks. This register works in conjunction with the DSP1MEMRETCFG register when DSP1 is OFF.</description>
          <addressOffset>0x00000078</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000003</resetMask>

          <fields>
            <field>
              <name>PWRENDSP1ICACHE</name>
              <description>Power up DSP1 ICACHE banks</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Do not power up ICACHE</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ON</name>
                  <description>Power up ICACHE</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRENDSP1RAM</name>
              <description>Power up DSP1 IRAM and DRAM</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Do not power ON any of the IRAM/DRAM</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ON</name>
                  <description>Power up all IRAM (32K) and DRAM (64K)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DSP1MEMPWRST</name>
          <description>It provides the power status for all the memories of DSP1 subsystem</description>
          <addressOffset>0x0000007C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000003</resetMask>

          <fields>
            <field>
              <name>PWRSTDSP1ICACHE</name>
              <description>Power Status- 1:ON, 0:OFF</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>PWRSTDSP1RAM</name>
              <description>Status- 1:ON, 0:OFF</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>DSP1MEMRETCFG</name>
          <description>This controls the power down of the DRAM/IRAM/CACHE banks when DSP1 is powered off. If this is set, then the power for that corresponding SRAM bank will be gated when the DSP1 is powered off and data is erased. If this is not set, retention voltage will be applied when DSP1 is powered off. Do not set this if the SRAM bank is used as the target for DMA transfer while DSP1 is powered off.</description>
          <addressOffset>0x00000080</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000001F</resetMask>

          <fields>
            <field>
              <name>DSP1RAMACTGFX</name>
              <description>Keep the memory domain active based on GFX state.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WAKEONDEMAND</name>
                  <description>Wakeup on demand</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACT</name>
                  <description>Keep RAMs active irrespective of GFX state</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DSP1RAMACTDISP</name>
              <description>Keep the memory domain active based on DISP state.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WAKEONDEMAND</name>
                  <description>Wakeup on demand</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACT</name>
                  <description>Keep RAMs active irrespective of DISP state</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ICACHEPWDDSP1OFF</name>
              <description>ICACHE is powered down when DSP1 is switched off, causing the contents of the bank to be lost.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RET</name>
                  <description>ICACHE retained</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWD</name>
                  <description>Power down ICACHE</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DSP1RAMACTMCU</name>
              <description>Keep the memory domain active based on MCU state.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WAKEONDEMAND</name>
                  <description>Wakeup on demand</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACT</name>
                  <description>Keep RAMs active irrespective of MCU state</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RAMPWDDSP1OFF</name>
              <description>IRAM/DRAM banks are powered down when DSP1 is switched off, causing the contents of the bank to be lost.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RET</name>
                  <description>IRAM and DRAM retained</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWD</name>
                  <description>Power down all IRAM and DRAM</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>PWRACKOVR</name>
          <description>This register contains override bit fields for various power domain power switch acknowledge notification. As a part of power up sequnce, Power controller will look for power switch ack to advance power up sequence. It is possible for power controller to be a forever wait state in case of a unforeseen HW bug. This register defines a bit fileds to work around if needed in such a situation.  The default behavior is to use HW power switch ack. Software can set it to override this feature for each power switch.</description>
          <addressOffset>0x00000084</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0003FFFF</resetMask>

          <fields>
            <field>
              <name>PWRACKOVERRIDEDSPA</name>
              <description>Power switch acknowledgement override from Power switch to power control ST MC</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DEFAULT</name>
                  <description>Hardware generates Power switch ack</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SWOVRRIDE</name>
                  <description>Software override or defeaure mode. Will bypass HW generated power ack</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRACKOVERRIDEUSBPHY</name>
              <description>Power switch acknowledgement override from Power switch to power control ST MC</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DEFAULT</name>
                  <description>Hardware generates Power switch ack</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SWOVRRIDE</name>
                  <description>Software override or defeaure mode. Will bypass HW generated power ack</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
