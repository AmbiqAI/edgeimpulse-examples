          <fields>
            <field>
              <name>HOSTSHADOWKCPREG</name>
              <description>This field is used to update the KCP registers when the device is in CM or DM mode, The KCP is updated by shifting</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HOSTSHADOWKCEREG</name>
          <description>This register interface is used to update the KCE registers when the device is in CM or DM mode, The KCE is updated by shifting</description>
          <addressOffset>0x00001F20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>HOSTSHADOWKCEREG</name>
              <description>This field is used to update the KCE registers when the device is in CM or DM mode, The KCE is updated by shifting</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HOSTSHADOWKPICVREG</name>
          <description>This register interface is used to update the KPICV registers when the device is in CM or DM mode, The KPICV is updated by shifting</description>
          <addressOffset>0x00001F24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>HOSTSHADOWKPICVREG</name>
              <description>This field is used to update the KPICV registers when the device is in CM or DM mode, The KPICV is updated by shifting</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HOSTSHADOWKCEICVREG</name>
          <description>This register interface is used to update the KCEICV registers when the device is in CM or DM mode, The KCEICV is updated by shifting</description>
          <addressOffset>0x00001F28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>HOSTSHADOWKCEICVREG</name>
              <description>This field is used to update the KCEICV registers when the device is in CM or DM mode, The KCEICV is updated by shifting</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>OTPADDRWIDTHDEF</name>
          <description>OTP_ADDR_WIDTH parameter, that will define the integrated OTP address width (address in words). The supported sizes are 6 (for 2 Kbits),7,8,9,11 (for 64 Kbits). The default value in the provided RTL will be 6.Note: This is a special register, affected by internal logic. Test result of this register is NA.</description>
          <addressOffset>0x00001F2C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000000B</resetValue>
          <resetMask>0x0000000F</resetMask>

          <fields>
            <field>
              <name>OTPADDRWIDTHDEF</name>
              <description>Holds the OTP_ADDR_WIDTH_DEF value.</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>DC</name>
      <version>1.0</version>
      <description>Display Controller</description>
      <!-- <groupName>GROUP_DC</groupName> -->
      <baseAddress>0x400A0000</baseAddress>
      <size>32</size>
      <access>read-write</access>

      <addressBlock>
        <offset>0</offset>
        <size>0x00001C04</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>DC</name>
        <description>DC_IRQ</description>
        <value>29</value>
      </interrupt>
      <registers>
        <register>
          <name>MODE</name>
          <description>General control register that activates the NEMAp|dc400  controller and various parameters, sets the timing signals'  polarity, activates the global look-up table for gamma correction and chooses the output display formats to meet LCD color specifications.</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>DC400ACT</name>
              <description>When set to 1, the dc400  controller is activated</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CUSOREN</name>
              <description>When set to 1, programmable cursor is enabled</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RSVD4</name>
              <description>This field is reserved.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>VSYNCPOL</name>
              <description>Defines VSYNC polarity</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>VSYNC_NEG</name>
                  <description>VSYNC polarity is negative</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VSYNC_POS</name>
                  <description>VSYNC polarity is positive</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HSYNCPOL</name>
              <description>Defines HSYNC polarity</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HSYNC_NEG</name>
                  <description>HSYNC polarity is negative</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HSYNC_POS</name>
                  <description>HSYNC polarity is positive</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DEPOL</name>
              <description>Defines DE polarity</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DE_NEG</name>
                  <description>DE polarity is negative</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DE_POS</name>
                  <description>DE polarity is positive</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RSVD3</name>
              <description>This field is reserved.</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DITHEREN</name>
              <description>When set to 1, dithering is enabled</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>VSYNCEN</name>
              <description>When set to 1, VSYNC for a single cycle per line is enabled</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>PIXCLKPOL</name>
              <description>Defines Pixel Clock out polarity</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>POL_NEG</name>
                  <description>Pixel Clock out polarity is negative</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>POL_POS</name>
                  <description>Pixel Clock out polarity is positive</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RSVD2</name>
              <description>This field is reserved.</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>GAMARAMPEN</name>
              <description>When set to 1, gamma ramp is enabled</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>BLANKFRC</name>
              <description>When set to 1, forces output to blank</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RSVD1</name>
              <description>This field is reserved.</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>FRAMEUPDTEN</name>
              <description>When set to 1, single frame update is enabled</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RSVD0</name>
              <description>This field is reserved.</description>
              <bitRange>[16:12]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>PLLCLKNDIV</name>
              <description>When set to 1, PLL_CLK is not divided</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LVDSPADSEN</name>
              <description>When set to 1, LVDS output pads are enabled</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>COLFMT</name>
              <description>Output color format:</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>YUV_EN</name>
                  <description>YUV/YCbCr format is enabled</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RGB_EN</name>
                  <description>RGB format is enabled</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DISPFMT</name>
              <description>Display data format</description>
              <bitRange>[8:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DPI</name>
                  <description>DPI Interface</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BYTE3</name>
                  <description>Byte-3 beat Interface</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BYTE4</name>
                  <description>Byte-4 beat (RGBX) Interface</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SERIAL</name>
                  <description>Two phase serial 12-bit</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LVDS2</name>
                  <description>LVDS 24-bit unbalanced single pixel format 2</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LVDS1</name>
                  <description>LVDS 24-bit unbalanced single pixel format 1</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>YUYV</name>
                  <description>YUYV (16-bit mode)</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BT656</name>
                  <description>BT.656</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>JDI</name>
                  <description>JDI MIP</description>
                  <value>8</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DBITYPEBEN</name>
              <description>When set to 1, DBI Type-B interface is enabled</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>YUYVEN</name>
              <description>When set to 1, the following output color formats are enabled : Byte-3 beat Interface enabled, Byte-4 beat (RGBX) Interface enabled, Two phase serial 12-bit enabled, YUYV (16-bit mode) enabled, BT.656 enabled, JDI MIP enabled</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LVDSINTEN</name>
              <description>When set to 1, LVDS interface is enabled</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DBLHORSCANEN</name>
              <description>When set to 1, double horizontal scan is enabled</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TSTMODEN</name>
              <description>When set to 1, test mode is enabled</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
