              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DEFAULT</name>
                  <description>Hardware generates Power switch ack</description>
                  <value>0</value>
                </enumeratedValue>
