              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Capture function disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Capture function enabled.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
