          <description>This contains the Compare limits for timer 0. This is the primary comparator that can be used to mark the END of a timer cycle (and thus restart the timer for repeat modes)</description>
          <addressOffset>0x00000208</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

