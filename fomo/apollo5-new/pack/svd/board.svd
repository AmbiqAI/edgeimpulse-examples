                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MODE3</name>
                  <description>Mode3</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NOTSUPPORTED</name>
                  <description>Clock Multiplier is not supported.</description>
                  <value>3</value>
