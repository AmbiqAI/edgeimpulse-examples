                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>GATESDCLKEN</name>
              <description>If this bit is 0, SD_CLK to card will not be gated automatically, when there is no transfer. If this bit set to 1, SD_CLK to card will be gated automatically,when there is no transfer.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>GATE</name>
                  <description>SD_CLK to card will be gated automatically when there is no transfer.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NOGATE</name>
                  <description>SD_CLK to card will NOT be gated automatically when there is no transfer.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
