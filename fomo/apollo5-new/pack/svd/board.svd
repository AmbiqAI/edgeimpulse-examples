          <fields>
            <field>
              <name>AUDADCKEEPOUTEN</name>
              <description>Audio ADC reference keeper out en</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>AUDADCRFBUFSLWEN</name>
              <description>Audio ADC reference buffer slew enable</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>AUDADCINBUFEN</name>
              <description>Audio ADC Input Buffer Power Enable ( if the AUDADCPWRCTRLSWE bit is set )</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>

