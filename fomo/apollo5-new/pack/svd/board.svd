              <description>Size of the operation in bytes.</description>
              <bitRange>[12:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>PKAL5</name>
          <description>This register holds one of the optional size of the operation.</description>
          <addressOffset>0x000000A4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00001FFF</resetMask>

          <fields>
            <field>
              <name>PKAL5</name>
              <description>Size of the operation in bytes.</description>
              <bitRange>[12:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>PKAL6</name>
          <description>This register holds one of the optional size of the operation.</description>
          <addressOffset>0x000000A8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00001FFF</resetMask>

          <fields>
            <field>
              <name>PKAL6</name>
              <description>Size of the operation in bytes.</description>
              <bitRange>[12:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>PKAL7</name>
          <description>This register holds one of the optional size of the operation.</description>
          <addressOffset>0x000000AC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00001FFF</resetMask>

          <fields>
            <field>
              <name>PKAL7</name>
              <description>Size of the operation in bytes.</description>
              <bitRange>[12:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>PKAPIPERDY</name>
          <description>This register indicates whether the PKA pipe is ready to receive a new OPCODE.</description>
          <addressOffset>0x000000B0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>PKAPIPERDY</name>
              <description>Indication whether PKA pipe is ready for new OPCODE.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>PKADONE</name>
          <description>This register indicates whether PKA operation is completed.</description>
          <addressOffset>0x000000B4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>PKADONE</name>
              <description>Indicates if PKA operation is completed, and pipe is empty.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>PKAMONSELECT</name>
          <description>This register defines which PKA FSM monitor is being output.</description>
          <addressOffset>0x000000B8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000000F</resetMask>

          <fields>
            <field>
              <name>PKAMONSELECT</name>
              <description>Defines which PKA FSM monitor is being output.</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>PKAVERSION</name>
          <description>This register holds the pka version</description>
          <addressOffset>0x000000C4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x16110215</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>PKAVERSION</name>
              <description>This is the PKA version</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>PKAMONREAD</name>
          <description>The PKA monitor bus register.</description>
          <addressOffset>0x000000D0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>PKAMONREAD</name>
              <description>This is the PKA monitor bus register output</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>PKASRAMADDR</name>
          <description>first address given to PKA SRAM for write transactions.</description>
          <addressOffset>0x000000D4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>PKASRAMADDR</name>
              <description>PKA SRAM write starting address</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>PKASRAMWDATA</name>
          <description>Write data to PKA SRAM.</description>
          <addressOffset>0x000000D8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>PKASRAMWDATA</name>
              <description>32 bit write to PKA SRAM: triggers the SRAM write DMA address automatically incremented</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>PKASRAMRDATA</name>
          <description>Read data from PKA SRAM.</description>
          <addressOffset>0x000000DC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>PKASRAMRDATA</name>
              <description>32 bit read from PKA SRAM: read - triggers the SRAM read DMA address automatically incremented</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>PKASRAMWRCLR</name>
          <description>Write buffer clean.</description>
          <addressOffset>0x000000E0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>PKASRAMWRCLR</name>
              <description>Clear the write buffer.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>PKASRAMRADDR</name>
          <description>first address given to PKA SRAM for read transactions.</description>
          <addressOffset>0x000000E4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>PKASRAMRADDR</name>
              <description>PKA SRAM read starting address</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>PKAWORDACCESS</name>
          <description>This register holds the data written to PKA memory using the wop opcode.</description>
          <addressOffset>0x000000F0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>PKAWORDACCESS</name>
              <description>32 bit read_write data.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>PKABUFFADDR</name>
          <description>This register maps the virtual buffer registers to a physical address in memory.</description>
          <addressOffset>0x000000F8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000FFF</resetMask>

          <fields>
            <field>
              <name>PKABUFADDR</name>
              <description>Contains the physical address in memory to map the buffer registers.</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>RNGIMR</name>
          <description>Interrupt masking register. Consists of {prng_imr trng_imr} bit[31-16] - PRNG_IMR bit[15-0] - TRNG_IMR(Ws - PRNG bit exists only if PRNG_EXISTS flag)</description>
          <addressOffset>0x00000100</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000003F</resetValue>
          <resetMask>0x0000003F</resetMask>

          <fields>
            <field>
              <name>RNGDMADONEINT</name>
              <description>0x1 - masks the RNG DMA completion interrupt. No interrupt is generated.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>WATCHDOGINTMASK</name>
              <description>0x1 - masks the watchdog interrupt. No interrupt is generated.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>VNERRINTMASK</name>
              <description>0x1 - masks the Von-Neumann error interrupt. No interrupt is generated.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CRNGTERRINTMASK</name>
              <description>0x1 - masks the CRNGT error interrupt. No interrupt is generated.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>AUTOCORRERRINTMASK</name>
              <description>0x1 - masks the autocorrelation interrupt. No interrupt is generated.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>EHRVALIDINTMASK</name>
              <description>0x1 - masks the EHR interrupt. No interrupt is generated.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>RNGISR</name>
          <description>Status register. If corresponding RNG_IMR bit is unmasked, an interrupt is generated.Consists of trng_isr and prng_isr bit[15-0] - TRNG bit[31-16] - PRNG</description>
          <addressOffset>0x00000104</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x07FF002F</resetMask>

          <fields>
            <field>
              <name>WHICHKATERR</name>
              <description>When the KAT_ERR bit is set, these bits represent which Known Answer Test had failed:</description>
              <bitRange>[26:25]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>INSTANT_1</name>
                  <description>first test of instantiation</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>INSTANT_2</name>
                  <description>second test of instantiation</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESEED_1</name>
                  <description>first test of reseeding</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESEED_2</name>
                  <description>second test of reseeding</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>KATERR</name>
              <description>0x1 indicates that one of the KAT (Known Answer Tests) tests has failed. When set, the entire engine ceases to function.</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>REQSIZE</name>
              <description>0x1 indicates that the request size counter (which represents how many generations of random bits in the PRNG have been produced) has reached 2^12, thus requiring a working state update before generating new random numbers.</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>PRNGCRNGTERR</name>
              <description>0x1 indicates CRNGT in the PRNG test failed. Failure occurs when two consecutive results of AES are equal</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RESEEDCNTRTOP40</name>
              <description>0x1 indicates that the top 40 bits of the reseed counter are set (that is the reseed counter is larger than 2^48-2^8). This is a recommendation for running the reseed algorithm before the counter reaches its max value.</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RESEEDCNTRFULL</name>
              <description>0x1 indicates that the reseed counter has reached 2^48, requiring to run the reseed algorithm before generating new random numbers.</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>OUTPUTREADY</name>
              <description>0x1 indicates that the result of PRNG is valid and ready to be read. The result can be read from the RNG_READOUT register.</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>FINALUPDATEDONE</name>
              <description>0x1 indicates completion of final update algorithm.</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>INSTANTIATIONDONE</name>
              <description>0x1 indicates completion of instantiation algorithm with no errors.</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RESEEDINGDONE</name>
              <description>0x1 indicates completion of reseeding algorithm with no errors.</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RNGDMADONE</name>
              <description>0x1 indicates RNG DMA to SRAM is completed.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>VNERR</name>
              <description>0x1 indicates Von Neumann error. Error in von Neumann occurs if 32 consecutive collected bits are identical, ZERO, or ONE.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CRNGTERR</name>
              <description>0x1 indicates CRNGT in the TRNG test failed. Failure occurs when two consecutive blocks of 16 collected bits are equal.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>AUTOCORRERR</name>
              <description>0x1 indicates Autocorrelation test failed four times in a row. When it set ,TRNG ceases to function until next reset.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>EHRVALID</name>
              <description>0x1 indicates that 192 bits have been collected in the TRNG and are ready to be read.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>RNGICR</name>
          <description>Interrupt_status bit clear Register. Consists of trng_icr and prng_icr bit[15-0] - TRNG bit[31-16] - PRNG</description>
          <addressOffset>0x00000108</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x07FF003F</resetMask>

          <fields>
            <field>
              <name>WHICHKATERR</name>
              <description>Cannot be cleared by SW! Only RNG reset clears this bit.</description>
              <bitRange>[26:25]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>KATERR</name>
              <description>Cannot be cleared by SW! Only RNG reset clears this bit.</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>REQSIZE</name>
              <description>Writing value 0x1 - clears corresponding bit in RNGISR</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>PRNGCRNGTERR</name>
              <description>Writing value 0x1 - clears corresponding bit in RNGISR</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RESEEDCNTRTOP40</name>
              <description>Writing value 0x1 - clears corresponding bit in RNGISR</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RESEEDCNTRFULL</name>
              <description>Writing value 0x1 - clears corresponding bit in RNGISR</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>OUTPUTREADY</name>
              <description>Writing value 0x1 - clears corresponding bit in RNGISR</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>FINALUPDATEDONE</name>
              <description>Writing value 0x1 - clears corresponding bit in RNGISR</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>INSTANTIATIONDONE</name>
              <description>Writing value 0x1 - clears corresponding bit in RNGISR</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RESEEDINGDONE</name>
              <description>Writing value 0x1 - clears corresponding bit in RNGISR</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RNGDMADONE</name>
              <description>Writing value 0x1 - clears corresponding bit in RNGISR</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RNGWATCHDOG</name>
              <description>Writing value 0x1 - clears corresponding bit in RNGISR</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>VNERR</name>
              <description>Writing value 0x1 - clears corresponding bit in RNGISR</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CRNGTERR</name>
              <description>Writing value 0x1 - clears corresponding bit in RNGISR</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>AUTOCORRERR</name>
              <description>Cannot be cleared by SW! Only RNG reset clears this bit.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>EHRVALID</name>
              <description>Writing value 0x1 - clears corresponding bit in RNGISR</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>TRNGCONFIG</name>
          <description>This register handles TRNG configuration</description>
          <addressOffset>0x0000010C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000007</resetMask>

          <fields>
            <field>
              <name>SOPSEL</name>
              <description>Secure Output Port selection:</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SOP_DATA_1</name>
                  <description>sop_data port reflects TRNG output (EHR_DATA).</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SOP_DATA_2</name>
                  <description>sop_data port reflects PRNG output (RNG_READOUT). Note: Secure output is used for direct connection of the RNG block outputs to an engine input key.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RNDSRCSEL</name>
              <description>Defines the length of the oscillator ring (= the number of inverters) out of four possible selections.</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>TRNGVALID</name>
          <description>This register indicates that the TRNG data is valid.</description>
          <addressOffset>0x00000110</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>EHRVALID</name>
              <description>0x1 indicates that collection of bits in the TRNG is completed, and data can be read from the EHR_DATA register.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>EHRDATA0</name>
          <description>This register contains the data collected in the TRNG[31_0]. Note: can only be set while in debug mode (rng_debug_enable input is set).</description>
          <addressOffset>0x00000114</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>EHRDATA</name>
              <description>Contains the data collected in the TRNG[31_0]. Note: can only be set while in debug mode (rng_debug_enable input is set).</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>EHRDATA1</name>
          <description>This register contains the data collected in the TRNG[63_32]. Note: can only be set while in debug mode (rng_debug_enable input is set).</description>
          <addressOffset>0x00000118</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>EHRDATA</name>
              <description>Contains the data collected in the TRNG[63_32]. Note: can only be set while in debug mode (rng_debug_enable input is set).</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>EHRDATA2</name>
          <description>This register contains the data collected in the TRNG[95_64]. Note: can only be set while in debug mode (rng_debug_enable input is set).</description>
          <addressOffset>0x0000011C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>EHRDATA</name>
              <description>Contains the data collected in the TRNG[95_64]. Note: can only be set while in debug mode (rng_debug_enable input is set).</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>EHRDATA3</name>
          <description>This register contains the data collected in the TRNG[127_96]. Note: can only be set while in debug mode (rng_debug_enable input is set).</description>
          <addressOffset>0x00000120</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>EHRDATA</name>
              <description>Contains the data collected in the TRNG[127_96]. Note: can only be set while in debug mode (rng_debug_enable input is set).</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>EHRDATA4</name>
