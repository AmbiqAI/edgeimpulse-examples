        <register>
          <name>DSP0CONTROL</name>
          <description>DSP 0 control settings</description>
          <addressOffset>0x00000100</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000006</resetValue>
          <resetMask>0x7FFFFF3F</resetMask>

          <fields>
            <field>
              <name>DSP0IDMAXTRIGSRC</name>
              <description>DSP 0 IDMA Cross Trigger Source. All enabled sources are ANDed to generate a trigger enable. \n Bit30-12:IRQ18-0 Bit11: IDMATRIGPULSE, Bit10: DSP Timer1, Bit9: DSP Timer0, Bit8: alternate DSP iDMA trigger out</description>
              <bitRange>[30:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DSP0IDMATRIG</name>
              <description>DSP 0 IDMA Trigger Control</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>XTRIG</name>
                  <description>Trigger is disabled until a cross trigger pulse is asserted. This will allow another source (determined by the XTRIGSRC register) to allow the DMA descriptor chain to proceed.</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SSTEP</name>
                  <description>Trigger is disabled until a trigger pulse (PULSE in IDMATRIG register) is asserted. This will allow a single step in the DMA descriptor chain to be enabled until next completion.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AON</name>
                  <description>Trigger is always enabled. With this set, any trigger out will immediately generate a trigger in</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Trigger is disabled. This will pause the iDMA indefinitely until enabled.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
