              <name>LEN</name>
              <description>Buffer size (bottom two bits assumed to be zero to ensure a multiple of 4 bytes)</description>
              <bitRange>[23:2]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
